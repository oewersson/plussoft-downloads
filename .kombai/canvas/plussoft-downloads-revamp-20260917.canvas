      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/tabler-icons.min.css');\n\n:root {\n  --ps-bg: #f5f7fa;\n  --ps-surface: #ffffff;\n  --ps-ink: #17233c;\n  --ps-muted: #718096;\n  --ps-line: #dfe5ed;\n  --ps-blue: #2448ad;\n  --ps-blue-deep: #183785;\n  --ps-blue-soft: #edf2ff;\n  --ps-green: #22745f;\n  --ps-green-soft: #eaf7f2;\n  --ps-orange: #f04a26;\n  --ps-shadow: 0 8px 24px rgba(23,35,60,.05);\n}\nbody { margin: 0; background: var(--ps-bg); color: var(--ps-ink); font-family: 'IBM Plex Sans', system-ui, sans-serif; }\n* { box-sizing: border-box; }\nbutton, input { font: inherit; }\nbutton { cursor: pointer; }\n\n.plussoft-scene { min-height: 100vh; display: flex; background: var(--ps-bg); }\n.ps-sidebar { width: 228px; flex: 0 0 228px; min-height: 800px; background: var(--ps-surface); border-right: 1px solid var(--ps-line); padding: 26px 16px 18px; display: flex; flex-direction: column; }\n.ps-brand { padding: 0 10px 30px; position: relative; }\n.ps-brand::after { content: ''; position: absolute; left: 10px; bottom: 0; width: 32px; height: 2px; background: var(--ps-orange); }\n.ps-brand img { display: block; width: 152px; height: auto; max-height: 44px; object-fit: contain; object-position: left center; }\n.ps-menu { display: flex; flex-direction: column; gap: 4px; padding-top: 28px; }\n.ps-menu-item { min-height: 42px; width: 100%; border: 0; border-left: 2px solid transparent; background: transparent; color: #3e4b62; display: flex; align-items: center; gap: 8px; padding: 0 10px 0 12px; border-radius: 0 7px 7px 0; text-align: left; font-size: 13px; transition: background .16s ease, border-color .16s ease, color .16s ease; }\n.ps-menu-item .ps-menu-index { width: 18px; flex: 0 0 18px; color: #b5bfcc; font: 500 10px/1 'IBM Plex Mono', monospace; }\n.ps-menu-item .ps-menu-text { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.ps-menu-item .ps-chevron { color: #a9b3c0; font-size: 15px; }\n.ps-menu-item:hover { background: #f7f9fc; color: var(--ps-ink); }\n.ps-menu-item:focus-visible { outline: 2px solid var(--ps-blue); outline-offset: 2px; }\n.ps-menu-item.active { border-left-color: var(--ps-blue); background: var(--ps-blue-soft); color: var(--ps-blue-deep); font-weight: 600; }\n.ps-menu-item.active .ps-menu-index { color: var(--ps-blue); }\n.ps-menu-item.active .ps-chevron { color: var(--ps-blue); }\n.ps-sidebar-bottom { margin-top: auto; padding-top: 18px; border-top: 1px solid var(--ps-line); }\n.ps-login { width: 100%; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border-radius: 7px; background: var(--ps-blue); color: #fff; font-size: 13px; font-weight: 600; text-decoration: none; box-shadow: 0 2px 0 var(--ps-blue-deep); transition: background .16s ease, transform .16s ease; }\n.ps-login:hover { background: var(--ps-blue-deep); transform: translateY(1px); }\n.ps-login:focus-visible { outline: 2px solid var(--ps-blue); outline-offset: 3px; }\n.ps-login i { font-size: 17px; }\n\n.ps-main { min-width: 0; flex: 1; padding: 29px 32px 24px; }\n.ps-content { max-width: 1090px; margin: 0 auto; }\n.ps-page-top { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 19px; }\n.ps-title-block { padding-left: 15px; border-left: 3px solid var(--ps-blue); }\n.ps-eyebrow { margin: 0 0 5px; color: #8995a6; font: 600 10px/1 'IBM Plex Mono', monospace; letter-spacing: .13em; text-transform: uppercase; }\n.ps-page-title { margin: 0; font-size: 28px; line-height: 1.12; letter-spacing: -.035em; font-weight: 700; }\n.ps-page-description { margin: 7px 0 0; color: var(--ps-muted); font-size: 14px; line-height: 1.35; }\n.ps-library-note { align-self: flex-start; padding-top: 6px; color: #8c97a7; font: 500 10px/1 'IBM Plex Mono', monospace; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }\n.ps-library-note::before { content: ''; display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: var(--ps-green); vertical-align: 1px; }\n\n.ps-hero { position: relative; display: grid; grid-template-columns: minmax(300px, .92fr) minmax(420px, 1.08fr); gap: 0; min-height: 114px; background: var(--ps-surface); border: 1px solid var(--ps-line); border-radius: 11px; box-shadow: var(--ps-shadow); overflow: hidden; }\n.ps-hero::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--ps-orange); }\n.ps-hero-copy { padding: 20px 24px 18px 28px; border-right: 1px solid var(--ps-line); }\n.ps-hero-title { margin: 0; font-size: 17px; line-height: 1.22; letter-spacing: -.015em; font-weight: 600; }\n.ps-hero-stats { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 15px; }\n.ps-stat { min-height: 26px; display: inline-flex; align-items: center; gap: 6px; padding: 0 9px; border: 1px solid #e1e7ef; border-radius: 5px; background: #fbfcfe; color: #516078; font-size: 11px; white-space: nowrap; }\n.ps-stat i { color: var(--ps-green); font-size: 13px; }\n.ps-stat.primary { color: var(--ps-ink); border-color: #d7e0f4; background: #f5f8ff; }\n.ps-stat.primary i { color: var(--ps-blue); }\n.ps-hero-search { padding: 20px 24px 18px; display: flex; flex-direction: column; justify-content: center; }\n.ps-search-label { margin: 0 0 7px; color: #8b96a6; font: 500 10px/1 'IBM Plex Mono', monospace; letter-spacing: .1em; text-transform: uppercase; }\n.ps-search { height: 47px; display: flex; align-items: center; gap: 10px; padding: 0 10px 0 14px; border: 1px solid #d5dde8; border-radius: 7px; background: #fff; }\n.ps-search:focus-within { border-color: var(--ps-blue); box-shadow: inset 0 -2px 0 var(--ps-blue); }\n.ps-search i { color: #8491a4; font-size: 18px; }\n.ps-search input { flex: 1; min-width: 0; border: 0; outline: 0; color: var(--ps-ink); background: transparent; font-size: 13px; }\n.ps-search input::placeholder { color: #9aa5b4; }\n.ps-key { padding: 4px 7px; border: 1px solid #dce3ec; border-radius: 4px; background: #f5f7fa; color: #7c8899; font: 500 10px/1 'IBM Plex Mono', monospace; white-space: nowrap; }\n\n.ps-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18px; margin: 26px 0 13px; padding-bottom: 11px; border-bottom: 1px solid var(--ps-line); }\n.ps-section-title-wrap { min-width: 0; display: flex; align-items: baseline; gap: 12px; }\n.ps-section-title { margin: 0; font-size: 19px; line-height: 1.2; letter-spacing: -.02em; font-weight: 600; }\n.ps-section-subtitle { margin: 0; color: var(--ps-muted); font-size: 12px; }\n.ps-section-meta { display: flex; align-items: center; gap: 11px; color: #8a95a4; font: 500 10px/1 'IBM Plex Mono', monospace; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }\n.ps-section-meta::before { content: ''; width: 34px; height: 1px; background: var(--ps-blue); }\n\n.ps-grid { display: grid; grid-template-columns: 1.03fr .97fr 1.03fr; gap: 14px; align-items: stretch; }\n.ps-card { min-width: 0; min-height: 238px; display: flex; flex-direction: column; padding: 16px 16px 14px; border: 1px solid var(--ps-line); border-radius: 9px; background: var(--ps-surface); box-shadow: 0 3px 11px rgba(23,35,60,.035); transition: border-color .16s ease, box-shadow .16s ease; }\n.ps-card:hover { border-color: #b9c8e8; box-shadow: 0 5px 16px rgba(36,72,173,.08); }\n.ps-card-header { display: flex; align-items: flex-start; gap: 11px; min-height: 49px; }\n.ps-app-icon { width: 48px; height: 48px; flex: 0 0 48px; display: grid; place-items: center; padding: 6px; border: 1px solid #e1e6ee; border-radius: 8px; background: #fbfcfe; }\n.ps-app-icon img { display: block; width: 100%; height: 100%; object-fit: contain; }\n.ps-app-info { min-width: 0; flex: 1; padding-top: 1px; }\n.ps-app-title { margin: 0; color: var(--ps-ink); font-size: 15px; line-height: 1.15; font-weight: 600; }\n.ps-app-category { margin-top: 4px; color: #8a95a5; font-size: 10px; line-height: 1.2; }\n.ps-status { flex: 0 0 auto; padding: 4px 7px; border: 1px solid #bee7d9; border-radius: 999px; background: var(--ps-green-soft); color: var(--ps-green); font-size: 10px; line-height: 1; font-weight: 600; }\n.ps-card-description { min-height: 49px; margin: 15px 0 14px; color: #667389; font-size: 12px; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }\n.ps-release { display: grid; grid-template-columns: 1fr 1.15fr; gap: 13px; padding: 11px 0 10px; border-top: 1px solid #e8edf3; border-bottom: 1px solid #e8edf3; }\n.ps-release-group { min-width: 0; }\n.ps-release-label { margin: 0 0 5px; color: #8d98a7; font: 500 9px/1 'IBM Plex Mono', monospace; letter-spacing: .06em; text-transform: uppercase; }\n.ps-release-value { margin: 0; color: var(--ps-ink); font: 500 12px/1.15 'IBM Plex Mono', monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.ps-release-group + .ps-release-group { padding-left: 13px; border-left: 1px solid #e8edf3; }\n.ps-card-actions { display: flex; gap: 8px; margin-top: auto; padding-top: 12px; }\n.ps-btn { min-height: 34px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; border-radius: 5px; font-size: 11px; font-weight: 600; text-decoration: none; transition: background .16s ease, border-color .16s ease, color .16s ease, transform .16s ease; }\n.ps-btn i { font-size: 14px; }\n.ps-btn.primary { flex: 1; border: 1px solid var(--ps-blue); background: var(--ps-blue); color: #fff; }\n.ps-btn.primary:hover { background: var(--ps-blue-deep); }\n.ps-btn.primary:active { transform: translateY(1px); }\n.ps-btn.secondary { flex: .82; border: 1px solid #d8e0ea; background: #fff; color: #36445b; }\n.ps-btn.secondary:hover { border-color: #b8c7e6; color: var(--ps-blue); }\n.ps-btn:focus-visible { outline: 2px solid var(--ps-blue); outline-offset: 3px; }\n\n.ps-footer { margin-top: 26px; padding: 14px 0 0; border-top: 1px solid var(--ps-line); display: flex; justify-content: space-between; gap: 20px; color: #8792a0; font-size: 10px; }\n.ps-footer p { margin: 0; }\n\n@media (max-width: 900px) {\n  .ps-sidebar { width: 205px; flex-basis: 205px; }\n  .ps-main { padding-inline: 22px; }\n  .ps-hero { grid-template-columns: 1fr; }\n  .ps-hero-copy { border-right: 0; border-bottom: 1px solid var(--ps-line); }\n  .ps-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n@media (max-width: 640px) {\n  .plussoft-scene { display: block; }\n  .ps-sidebar { display: none; }\n  .ps-main { padding: 20px 16px; }\n  .ps-page-top { align-items: flex-start; }\n  .ps-library-note { display: none; }\n  .ps-page-title { font-size: 24px; }\n  .ps-page-description { font-size: 13px; }\n  .ps-hero-copy, .ps-hero-search { padding-inline: 18px; }\n  .ps-section-head { align-items: flex-start; flex-direction: column; gap: 8px; }\n  .ps-section-title-wrap { flex-direction: column; gap: 4px; }\n  .ps-grid { grid-template-columns: 1fr; }\n  .ps-footer { flex-direction: column; gap: 4px; }\n}\n</style>\n<div class=\"plussoft-scene\" data-kid=\"1\" data-name=\"scene container\">\n    <aside class=\"ps-sidebar\" data-kid=\"1-1\" data-name=\"sidebar navigation\" id=\"sidebar\">\n        <div class=\"ps-brand\" data-kid=\"1-1-1\" data-name=\"brand logo container\">\n            <img alt=\"PlusSoft Logo\" data-kid=\"1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/logo-plussoft.png\"/>\n        </div>\n        <nav aria-label=\"Categorias\" class=\"ps-menu\" data-kid=\"1-1-2\" data-name=\"navigation menu list\">\n            <button class=\"ps-menu-item active menu-item\" data-id=\"plussoft\" data-kid=\"1-1-2-1\" data-name=\"navigation menu item\">\n                <span class=\"ps-menu-index\" data-kid=\"1-1-2-1-1\" data