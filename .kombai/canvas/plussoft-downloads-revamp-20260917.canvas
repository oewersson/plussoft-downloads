    "var_91de07308ee3": {
      "type": "variant",
      "label": "PlusSoft — Mapa de lançamentos",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5520,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700&display=swap');\n\n  .plussoft-page {\n    --page: #f4f7fb;\n    --surface: #ffffff;\n    --ink: #111e3c;\n    --muted: #6e7b8d;\n    --line: #dce4ee;\n    --blue: #1f46a6;\n    --blue-dark: #163780;\n    --blue-soft: #e9f0ff;\n    --green: #247563;\n    --green-soft: #ecf8f3;\n    --orange: #f14a25;\n    min-height: 800px;\n    background: var(--page);\n    color: var(--ink);\n    font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;\n    font-size: 13px;\n    line-height: 1.45;\n  }\n\n  .plussoft-page *,\n  .plussoft-page *::before,\n  .plussoft-page *::after { box-sizing: border-box; }\n  .plussoft-page button,\n  .plussoft-page input { font: inherit; }\n  .plussoft-page button { cursor: pointer; }\n  .plussoft-page a { color: inherit; text-decoration: none; }\n\n  .app-shell {\n    min-height: 800px;\n    display: grid;\n    grid-template-columns: 226px minmax(0, 1fr);\n  }\n\n  .sidebar {\n    min-height: 800px;\n    display: flex;\n    flex-direction: column;\n    padding: 24px 16px 18px;\n    background: var(--surface);\n    border-right: 1px solid var(--line);\n  }\n  .brand {\n    display: flex;\n    align-items: center;\n    padding: 0 10px 22px;\n    border-bottom: 1px solid #edf1f6;\n  }\n  .brand img {\n    display: block;\n    width: 145px;\n    height: auto;\n    max-width: 100%;\n    object-fit: contain;\n  }\n  .menu {\n    display: flex;\n    flex-direction: column;\n    gap: 3px;\n    padding-top: 24px;\n  }\n  .menu-item {\n    position: relative;\n    min-height: 40px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 0 10px 0 16px;\n    border: 1px solid transparent;\n    border-radius: 7px;\n    color: #30405a;\n    background: transparent;\n    text-align: left;\n    transition: background .16s ease, color .16s ease, border-color .16s ease;\n  }\n  .menu-item::before {\n    content: '';\n    width: 8px;\n    height: 1px;\n    flex: 0 0 8px;\n    background: #c7d0dc;\n    transition: width .16s ease, background .16s ease;\n  }\n  .menu-item:hover,\n  .menu-item:focus-visible {\n    color: var(--ink);\n    background: #f6f8fb;\n    outline: none;\n  }\n  .menu-item.active {\n    color: var(--blue);\n    font-weight: 700;\n    background: var(--blue-soft);\n    border-color: #dbe6ff;\n  }\n  .menu-item.active::before { width: 20px; background: var(--blue); }\n  .menu-text { flex: 1; font-size: 12px; white-space: nowrap; }\n  .menu-chevron {\n    color: #a5b1c1;\n    font-size: 17px;\n    line-height: 1;\n  }\n  .menu-item.active .menu-chevron { color: var(--blue); }\n  .sidebar-bottom {\n    margin-top: auto;\n    padding-top: 16px;\n    border-top: 1px solid #edf1f6;\n  }\n  .login-btn {\n    min-height: 42px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    border: 0;\n    border-radius: 7px;\n    background: var(--blue);\n    color: #fff;\n    font-weight: 700;\n    font-size: 12px;\n    box-shadow: inset 0 -2px 0 rgba(17,30,60,.18);\n  }\n  .login-btn:hover { background: var(--blue-dark); }\n  .login-btn svg { width: 16px; height: 16px; }\n\n  .main {\n    min-width: 0;\n    min-height: 800px;\n    display: flex;\n    flex-direction: column;\n  }\n  .content {\n    width: min(100%, 1100px);\n    flex: 1;\n    padding: 26px 34px 22px;\n    margin: 0 auto;\n  }\n  .page-heading {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n  .page-heading::after {\n    content: '';\n    width: 34px;\n    height: 2px;\n    margin-left: 2px;\n    background: var(--blue);\n  }\n  .main-heading {\n    margin: 0;\n    color: var(--ink);\n    font-size: 25px;\n    line-height: 1.1;\n    letter-spacing: -.04em;\n    font-weight: 700;\n  }\n  .mobile-menu { display: none; }\n\n  .hero {\n    position: relative;\n    display: grid;\n    grid-template-columns: 44% 56%;\n    gap: 26px;\n    min-height: 126px;\n    margin-top: 20px;\n    padding: 18px 20px;\n    background: var(--surface);\n    border: 1px solid var(--line);\n    border-radius: 11px;\n    overflow: hidden;\n  }\n  .hero::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 20px;\n    width: 54px;\n    height: 2px;\n    background: var(--orange);\n  }\n  .hero-text h2 {\n    max-width: 340px;\n    margin: 0 0 14px;\n    color: var(--ink);\n    font-size: 17px;\n    line-height: 1.22;\n    letter-spacing: -.025em;\n    font-weight: 700;\n  }\n  .stats-row {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 7px;\n  }\n  .stat-badge {\n    min-height: 29px;\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    padding: 0 9px;\n    border: 1px solid #dfe6ef;\n    border-radius: 6px;\n    color: #4f5e73;\n    background: #fbfcfe;\n    font-size: 10px;\n    font-weight: 600;\n  }\n  .stat-badge svg { width: 13px; height: 13px; color: var(--green); }\n  .stat-badge.blue { color: var(--blue); background: var(--blue-soft); border-color: #d8e3ff; }\n  .stat-badge.blue svg { color: var(--blue); }\n  .search-container {\n    display: flex;\n    align-items: center;\n    min-width: 0;\n  }\n  .search {\n    width: 100%;\n    min-height: 48px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 0 12px;\n    background: #fbfcfe;\n    border: 1px solid #dce4ee;\n    border-radius: 8px;\n    transition: border-color .16s ease, box-shadow .16s ease;\n  }\n  .search:focus-within {\n    border-color: var(--blue);\n    box-shadow: inset 0 -2px 0 var(--blue);\n  }\n  .search-icon { width: 18px; height: 18px; flex: 0 0 18px; color: #8996a8; }\n  .search input {\n    min-width: 0;\n    flex: 1;\n    border: 0;\n    outline: 0;\n    padding: 2px 0;\n    color: var(--ink);\n    background: transparent;\n    font-size: 12px;\n  }\n  .search input::placeholder { color: #9aa6b6; }\n  .shortcut-badge {\n    flex: 0 0 auto;\n    padding: 4px 7px;\n    border: 1px solid #dce4ee;\n    border-radius: 4px;\n    color: #78869a;\n    background: #f4f7fa;\n    font-family: 'IBM Plex Mono', monospace;\n    font-size: 9px;\n  }\n\n  .section-head {\n    display: flex;\n    align-items: end;\n    gap: 18px;\n    margin: 22px 0 12px;\n  }\n  .section-head > div:first-child { flex: 0 0 auto; }\n  .section-head h2 {\n    margin: 0;\n    color: var(--ink);\n    font-size: 17px;\n    line-height: 1.15;\n    letter-spacing: -.025em;\n    font-weight: 700;\n  }\n  .section-head p {\n    margin: 4px 0 0;\n    color: var(--muted);\n    font-size: 10px;\n  }\n  .section-ruler {\n    flex: 1;\n    min-width: 80px;\n    height: 12px;\n    margin-bottom: 3px;\n    background: repeating-linear-gradient(90deg, transparent 0 18px, #d7e0eb 18px 19px);\n    opacity: .8;\n  }\n  .section-ruler::after {\n    content: '';\n    display: block;\n    width: 28px;\n    height: 2px;\n    margin-top: 5px;\n    background: var(--blue);\n  }\n\n  .grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 13px;\n  }\n  .card {\n    min-width: 0;\n    min-height: 202px;\n    display: flex;\n    flex-direction: column;\n    padding: 14px;\n    background: var(--surface);\n    border: 1px solid #dce4ee;\n    border-radius: 10px;\n    box-shadow: 0 1px 1px rgba(17,30,60,.025);\n    transition: border-color .16s ease, box-shadow .16s ease;\n  }\n  .card:hover {\n    border-color: #9fb8e8;\n    box-shadow: 0 3px 9px rgba(31,70,166,.07);\n  }\n  .card-header {\n    display: grid;\n    grid-template-columns: 44px minmax(0, 1fr) auto;\n    align-items: start;\n    gap: 10px;\n  }\n  .app-icon-wrap {\n    position: relative;\n    width: 44px;\n    height: 44px;\n    display: grid;\n    place-items: center;\n    overflow: hidden;\n    border: 1px solid #e0e6ee;\n    border-radius: 8px;\n    background: #f8fafc;\n  }\n  .app-icon-img {\n    position: relative;\n    z-index: 1;\n    width: 100%;\n    height: 100%;\n    padding: 5px;\n    object-fit: contain;\n  }\n  .app-monogram {\n    position: absolute;\n    color: var(--blue);\n    font-size: 16px;\n    font-weight: 700;\n  }\n  .app-info { min-width: 0; padding-top: 1px; }\n  .app-title {\n    display: -webkit-box;\n    margin: 0;\n    overflow: hidden;\n    color: var(--ink);\n    font-size: 13px;\n    line-height: 1.18;\n    font-weight: 700;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n  }\n  .app-category {\n    margin-top: 4px;\n    color: var(--muted);\n    font-size: 9px;\n    line-height: 1.15;\n  }\n  .status {\n    align-self: start;\n    padding: 4px 7px;\n    border: 1px solid #ccecdf;\n    border-radius: 999px;\n    color: var(--green);\n    background: var(--green-soft);\n    font-size: 8px;\n    line-height: 1;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n  .card > p {\n    display: -webkit-box;\n    min-height: 39px;\n    margin: 14px 0 12px;\n    overflow: hidden;\n    color: #677487;\n    font-size: 10px;\n    line-height: 1.42;\n    -webkit-line-clamp: 3;\n    -webkit-box-orient: vertical;\n  }\n  .meta {\n    display: grid;\n    grid-template-columns: 1fr 1.2fr;\n    gap: 10px;\n    margin-top: auto;\n    padding: 10px 0 9px;\n    border-top: 1px solid #edf1f5;\n    border-bottom: 1px solid #edf1f5;\n  }\n  .meta > div + div { padding-left: 10px; border-left: 1px solid #edf1f5; }\n  .meta-label {\n    color: #8a96a6;\n    font-size: 8px;\n    line-height: 1;\n    letter-spacing: .045em;\n    text-transform: uppercase;\n    font-weight: 700;\n  }\n  .meta-value {\n    margin-top: 5px;\n    color: var(--ink);\n    font-family: 'IBM Plex Mono', monospace;\n    font-size: 10px;\n    line-height: 1.1;\n    font-weight: 600;\n    white-space: nowrap;\n  }\n  .card-actions {\n    display: grid;\n    grid-template-columns: 1fr .78fr;\n    gap: 8px;\n    margin-top: 10px;\n  }\n  .btn {\n    min-height: 32px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    padding: 0 9px;\n    border-radius: 6px;\n    font-size: 10px;\n    font-weight: 700;\n    transition: background .16s ease, color .16s ease, border-color .16s ease;\n  }\n  .btn svg { width: 13px; height: 13px; }\n  .btn-primary { border: 1px solid var(--blue); background: var(--blue); color: #fff; }\n  .btn-primary:hover { border-color: var(--blue-dark); background: var(--blue-dark); }\n  .btn-secondary { border: 1px solid #d7e0eb; background: #fff; color: #35445a; }\n  .btn-secondary:hover { border-color: #9fb8e8; color: var(--blue); background: #f8faff; }\n  .empty { display: none; }\n\n  .app-footer {\n    min-height: 34px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    padding: 8px 34px;\n    border-top: 1px solid var(--line);\n    background: #eef3f8;\n    color: #748195;\n    font-size: 9px;\n  }\n  .app-footer p { margin: 0; }\n\n  .modal-overlay { display: none; }\n  .modal-content { display: none; }\n\n  @media (max-width: 960px) {\n    .app-shell { grid-template-columns: 210px minmax(0, 1fr); }\n    .content { padding-inline: 24px; }\n    .hero { grid-template-columns: 1fr; gap: 16px; }\n  }\n  @media (max-width: 720px) {\n    .app-shell { display: block; }\n    .sidebar { position: fixed; inset: 0 auto 0 0; z-index: 5; width: min(286px, 86vw); transform: translateX(-100%); }\n    .sidebar.open { transform: translateX(0); }\n    .main { min-height: 800px; }\n    .content { padding: 18px 16px 20px; }\n    .mobile-menu { width: 40px; height: 40px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 7px; background: #fff; color: var(--ink); }\n    .page-heading { align-items: center; }\n    .main-heading { font-size: 21px; }\n    .hero { margin-top: 16px; padding: 16px; }\n    .grid { grid-template-columns: 1fr; }\n    .app-footer { align-items: flex-start; flex-direction: column; padding: 12px 16px; }\n  }\n</style>\n<div class=\"plussoft-page\" data-kid=\"1\">\n    <div class=\"app-shell\" data-kid=\"1-1\">\n        <aside class=\"sidebar\" data-kid=\"1-1-1\" id=\"sidebar\">\n            <div class=\"brand\" data-kid=\"1-1-1-1\">\n                <img alt=\"PlusSoft Logo\" data-kid=\"1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/logo-plussoft.png\"/>\n            </div>\n            <nav aria-label=\"Categorias de produtos\" class=\"menu\" data-kid=\"1-1-1-2\">\n                <button class=\"menu-item active\" data-id=\"plussoft\" data-kid=\"1-1-1-2-1\">\n                    <span class=\"menu-text\" data-kid=\"1-1-1-2-1-1\">\n                        Ferramentas PlusSoft\n                    </span>\n                    <span class=\"menu-chevron\" data-kid=\"1-1-1-2-1-2\">\n                        ›\n                    </span>\n                </button>\n                <button class=\"menu-item\" data-id=\"idealsoft\" data-kid=\"1-1-1-2-2\">\n                    <span class=\"menu-text\" data-kid=\"1-1-1-2-2-1\">\n                        IdealSoft\n                    </span>\n                    <span class=\"menu-chevron\" data-kid=\"1-1-1-2-2-2\">\n                        ›\n                    </span>\n                </button>\n                <button class=\"menu-item\" data-id=\"links\" data-kid=\"1-1-1-2-3\">\n                    <span class=\"menu-text\" data-kid=\"1-1-1-2-3-1\">\n                        Links Úteis\n                    </span>\n                    <span class=\"menu-chevron\" data-kid=\"1-1-1-2-3-2\">\n                        ›\n                    </span>\n                </button>\n                <button class=\"menu-item\" data-id=\"sql\" data-kid=\"1-1-1-2-4\">\n                    <span class=\"menu-text\" data-kid=\"1-1-1-2-4-1\">\n                        Ferramentas SQL\n                    </span>\n                    <span class=\"menu-chevron\" data-kid=\"1-1-1-2-4-2\">\n                        ›\n                    </span>\n      