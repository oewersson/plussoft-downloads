      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.34.0/dist/tabler-icons.min.css');\n\n  .ps-page {\n    --ps-bg: #f6f8fb;\n    --ps-surface: #ffffff;\n    --ps-ink: #12213c;\n    --ps-muted: #6c788a;\n    --ps-line: #dde4ed;\n    --ps-line-strong: #ccd6e2;\n    --ps-blue: #2149b5;\n    --ps-blue-dark: #163c9e;\n    --ps-blue-soft: #edf3ff;\n    --ps-green: #1d7662;\n    --ps-green-soft: #ecf8f3;\n    --ps-orange: #ef4b27;\n    min-height: 800px;\n    background: var(--ps-bg);\n    color: var(--ps-ink);\n    font-family: 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif;\n    font-size: 14px;\n    line-height: 1.4;\n    display: flex;\n  }\n  .ps-page *, .ps-page *::before, .ps-page *::after { box-sizing: border-box; }\n  .ps-page button, .ps-page input { font: inherit; }\n  .ps-page button, .ps-page a { -webkit-tap-highlight-color: transparent; }\n  .ps-page a { color: inherit; text-decoration: none; }\n\n  .ps-sidebar {\n    width: 236px;\n    flex: 0 0 236px;\n    min-height: 800px;\n    background: var(--ps-surface);\n    border-right: 1px solid var(--ps-line);\n    padding: 25px 16px 16px;\n    display: flex;\n    flex-direction: column;\n  }\n  .ps-brand {\n    padding: 0 11px 29px;\n    border-bottom: 1px solid #edf1f5;\n  }\n  .ps-brand img {\n    width: 151px;\n    height: auto;\n    max-width: 100%;\n    display: block;\n  }\n  .ps-brand-rule {\n    width: 28px;\n    height: 3px;\n    margin-top: 18px;\n    background: var(--ps-blue);\n  }\n  .ps-menu {\n    display: grid;\n    gap: 4px;\n    padding-top: 20px;\n  }\n  .ps-menu-item {\n    position: relative;\n    min-height: 43px;\n    border: 0;\n    border-radius: 7px;\n    background: transparent;\n    color: #31405a;\n    padding: 0 10px 0 15px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    text-align: left;\n    cursor: pointer;\n    transition: background .16s ease, color .16s ease;\n  }\n  .ps-menu-item::before {\n    content: '';\n    position: absolute;\n    left: 6px;\n    width: 7px;\n    height: 1px;\n    background: #bdc8d5;\n    transition: width .16s ease, background .16s ease;\n  }\n  .ps-menu-item:hover { background: #f5f7fb; color: var(--ps-ink); }\n  .ps-menu-item.active { background: var(--ps-blue-soft); color: var(--ps-blue); font-weight: 600; }\n  .ps-menu-item.active::before { width: 18px; background: var(--ps-blue); }\n  .ps-menu-item:focus-visible { outline: 2px solid var(--ps-blue); outline-offset: 2px; }\n  .ps-menu-text { font-size: 13px; padding-left: 7px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .ps-menu-chevron { color: #9aa7b8; font-size: 17px; line-height: 1; padding-left: 8px; }\n  .ps-menu-item.active .ps-menu-chevron { color: var(--ps-blue); }\n  .ps-sidebar-bottom { margin-top: auto; padding-top: 18px; border-top: 1px solid #edf1f5; }\n  .ps-login {\n    min-height: 43px;\n    width: 100%;\n    border-radius: 7px;\n    background: var(--ps-blue);\n    color: white;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    font-size: 13px;\n    font-weight: 600;\n    box-shadow: inset 0 -2px 0 rgba(8, 37, 111, .28);\n    transition: background .16s ease;\n  }\n  .ps-login:hover { background: var(--ps-blue-dark); }\n  .ps-login:focus-visible { outline: 2px solid var(--ps-blue); outline-offset: 3px; }\n  .ps-login i { font-size: 17px; }\n\n  .ps-main {\n    min-width: 0;\n    flex: 1;\n    min-height: 800px;\n    display: flex;\n    flex-direction: column;\n  }\n  .ps-content {\n    width: 100%;\n    max-width: 1260px;\n    padding: 30px 34px 22px;\n    margin: 0 auto;\n    flex: 1;\n  }\n  .ps-page-heading {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin-bottom: 18px;\n  }\n  .ps-mobile-menu { display: none; }\n  .ps-main-heading {\n    margin: 0;\n    color: var(--ps-ink);\n    font-size: 28px;\n    line-height: 1.12;\n    font-weight: 700;\n    letter-spacing: -.035em;\n  }\n  .ps-heading-mark {\n    width: 36px;\n    height: 3px;\n    margin-top: 10px;\n    background: var(--ps-blue);\n  }\n\n  .ps-hero {\n    min-height: 112px;\n    display: grid;\n    grid-template-columns: minmax(0, .93fr) minmax(360px, 1.07fr);\n    align-items: center;\n    gap: 24px;\n    padding: 21px 22px;\n    background: var(--ps-surface);\n    border: 1px solid var(--ps-line);\n    border-radius: 10px;\n    position: relative;\n  }\n  .ps-hero::before {\n    content: '';\n    position: absolute;\n    top: 17px;\n    bottom: 17px;\n    left: 50%;\n    width: 1px;\n    background: #e8edf3;\n  }\n  .ps-hero-copy { min-width: 0; padding-right: 16px; }\n  .ps-hero-title { margin: 0; font-size: 18px; line-height: 1.2; font-weight: 600; letter-spacing: -.02em; }\n  .ps-stat-row { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 14px; }\n  .ps-stat {\n    min-height: 26px;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    border: 1px solid var(--ps-line);\n    border-radius: 5px;\n    background: #fbfcfe;\n    padding: 4px 9px;\n    color: #48566b;\n    font-size: 11px;\n    line-height: 1;\n    white-space: nowrap;\n  }\n  .ps-stat strong { color: var(--ps-ink); font-weight: 600; }\n  .ps-stat i { color: var(--ps-blue); font-size: 14px; }\n  .ps-stat.official i { color: var(--ps-green); }\n  .ps-stat.sync i { color: #7390b6; }\n\n  .ps-search-wrap { min-width: 0; padding-left: 2px; }\n  .ps-search-label { display: block; margin: 0 0 7px 2px; color: var(--ps-muted); font-size: 10px; font-weight: 600; letter-spacing: .11em; text-transform: uppercase; }\n  .ps-search {\n    min-height: 48px;\n    width: 100%;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 0 11px 0 14px;\n    border: 1px solid var(--ps-line-strong);\n    border-radius: 7px;\n    background: #fff;\n    transition: border-color .16s ease, box-shadow .16s ease;\n  }\n  .ps-search:focus-within { border-color: var(--ps-blue); box-shadow: inset 0 -2px 0 var(--ps-blue); }\n  .ps-search i { color: #8794a6; font-size: 18px; flex: 0 0 auto; }\n  .ps-search input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--ps-ink); font-size: 13px; }\n  .ps-search input::placeholder { color: #9aa6b5; }\n  .ps-shortcut { border: 1px solid #dfe5ec; border-radius: 4px; background: #f6f8fb; color: #718097; padding: 4px 7px; font-family: 'IBM Plex Mono', monospace; font-size: 10px; white-space: nowrap; }\n\n  .ps-section-head {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 18px;\n    margin: 27px 0 13px;\n    padding-bottom: 12px;\n    border-bottom: 1px solid var(--ps-line-strong);\n  }\n  .ps-section-title { margin: 0; font-size: 19px; line-height: 1.1; font-weight: 600; letter-spacing: -.02em; }\n  .ps-section-desc { margin: 5px 0 0; color: var(--ps-muted); font-size: 12px; }\n  .ps-section-meta { color: #7b889a; font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: .04em; white-space: nowrap; }\n  .ps-section-meta::before { content: ''; display: inline-block; width: 18px; height: 2px; margin: 0 8px 3px 0; background: var(--ps-blue); }\n\n  .ps-grid {\n    display: grid;\n    grid-template-columns: 1.05fr 1fr 1fr;\n    gap: 14px;\n  }\n  .ps-card {\n    min-height: 230px;\n    display: flex;\n    flex-direction: column;\n    padding: 16px 16px 14px;\n    background: var(--ps-surface);\n    border: 1px solid var(--ps-line);\n    border-radius: 9px;\n    position: relative;\n    overflow: hidden;\n    transition: border-color .16s ease, background .16s ease;\n  }\n  .ps-card::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: transparent; transition: background .16s ease; }\n  .ps-card:hover { border-color: #aebfe4; background: #fdfefe; }\n  .ps-card:hover::after { background: #b6c8ee; }\n  .ps-card:focus-within { outline: 2px solid var(--ps-blue); outline-offset: 2px; }\n  .ps-card-top { display: flex; align-items: flex-start; gap: 11px; min-width: 0; }\n  .ps-app-icon {\n    width: 48px;\n    height: 48px;\n    flex: 0 0 48px;\n    display: grid;\n    place-items: center;\n    border: 1px solid #dfe6ef;\n    border-radius: 9px;\n    background: #f9fbfd;\n    overflow: hidden;\n  }\n  .ps-app-icon img { width: 100%; height: 100%; padding: 6px; object-fit: contain; display: block; }\n  .ps-app-info { min-width: 0; flex: 1; padding-top: 2px; }\n  .ps-index { color: #a0adbc; font-family: 'IBM Plex Mono', monospace; font-size: 9px; letter-spacing: .06em; }\n  .ps-app-title { margin: 3px 0 0; color: var(--ps-ink); font-size: 15px; line-height: 1.16; font-weight: 600; }\n  .ps-app-category { margin-top: 4px; color: #8491a1; font-size: 10px; }\n  .ps-status { flex: 0 0 auto; border: 1px solid #c9eadf; border-radius: 999px; background: var(--ps-green-soft); color: var(--ps-green); padding: 4px 8px; font-size: 9px; font-weight: 600; white-space: nowrap; }\n  .ps-description { margin: 14px 0 15px; color: #667488; font-size: 12px; line-height: 1.42; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; flex: 1; }\n  .ps-release { border-top: 1px solid #e7ecf2; border-bottom: 1px solid #e7ecf2; display: grid; grid-template-columns: 1fr 1.18fr; gap: 12px; padding: 10px 0 9px; }\n  .ps-release-label { color: #8995a5; font-size: 9px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }\n  .ps-release-value { margin-top: 3px; color: var(--ps-ink); font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; }\n  .ps-release-value.muted { color: #9ba6b4; }\n  .ps-card-actions { display: grid; grid-template-columns: 1.08fr .92fr; gap: 8px; padding-top: 12px; }\n  .ps-btn { min-height: 34px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 0 10px; font-size: 11px; font-weight: 600; cursor: pointer; }\n  .ps-btn i { font-size: 14px; }\n  .ps-btn-primary { border: 1px solid var(--ps-blue); background: var(--ps-blue); color: #fff; }\n  a.ps-btn-primary { color: #fff; }\n  .ps-btn-primary:hover { background: var(--ps-blue-dark); }\n  .ps-btn-secondary { border: 1px solid var(--ps-line-strong); background: #fff; color: #3d4b60; }\n  .ps-btn-secondary:hover { border-color: #9fb3dc; color: var(--ps-blue); }\n  .ps-btn:focus-visible { outline: 2px solid var(--ps-blue); outline-offset: 2px; }\n\n  .ps-empty { display: none; }\n  .ps-footer { min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 34px; border-top: 1px solid var(--ps-line); background: #f0f4f9; color: #7c8999; font-size: 10px; }\n  .ps-footer p { margin: 0; }\n\n  .ps-modal-overlay { position: fixed; inset: 0; z-index: 20; display: none; align-items: center; justify-content: center; background: rgba(18, 33, 60, .42); }\n  .ps-modal-content { width: min(560px, calc(100% - 32px)); padding: 22px; border: 1px solid var(--ps-line); border-radius: 10px; background: #fff; box-shadow: 0 18px 38px rgba(18, 33, 60, .16); position: relative; }\n  .ps-modal-close { position: absolute; top: 14px; right: 14px; width: 34px; height: 34px; border: 1px solid transparent; border-radius: 6px; background: transparent; color: #8290a1; display: grid; place-items: center; cursor: pointer; }\n  .ps-modal-close:hover { background: #f3f6fa; color: var(--ps-ink); }\n  .ps-modal-close:focus-visible { outline: 2px solid var(--ps-blue); outline-offset: 2px; }\n  .ps-modal-header { display: flex; align-items: center; gap: 12px; padding-right: 42px; padding-bottom: 16px; border-bottom: 1px solid var(--ps-line); }\n  .ps-modal-icon { width: 46px; height: 46px; border: 1px solid #dfe6ef; border-radius: 8px; background: #f9fbfd; display: grid; place-items: center; }\n  .ps-modal-icon img { width: 100%; height: 100%; padding: 6px; object-fit: contain; }\n  .ps-modal-title { margin: 0; font-size: 17px; font-weight: 600; }\n  .ps-modal-category { color: var(--ps-blue); font-size: 11px; }\n  .ps-modal-body { padding-top: 16px; }\n  .ps-modal-desc { margin: 0 0 10px; color: #4f5d70; font-size: 12px; font-weight: 600; }\n  .ps-modal-versions { margin-top: 0; max-height: 190px; overflow: auto; }\n  .ps-version-row { display: grid; grid-template-columns: 1fr 1fr auto; gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid #edf1f5; font-size: 11px; }\n  .ps-version-row strong { font-family: 'IBM Plex Mono', monospace; font-weight: 600; }\n  .ps-version-date { color: #738198; font-family: 'IBM Plex Mono', monospace; }\n  .ps-version-download { border: 1px solid var(--ps-blue); border-radius: 5px; background: #fff; color: var(--ps-blue); padding: 5px 8px; font-size: 10px; font-weight: 600; }\n\n  @media (max-width: 920px) {\n    .ps-sidebar { width: 212px; flex-basis: 212px; }\n    .ps-content { padding-left: 22px; padding-right: 22px; }\n    .ps-hero { grid-template-columns: 1fr; gap: 16px; }\n    .ps-hero::before { display: none; }\n    .ps-hero-copy { padding-right: 0; }\n    .ps-search-wrap { padding-left: 0; }\n    .ps-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  }\n  @media (max-width: 650px) {\n    .ps-page { min-height: 100vh; display: block; }\n    .ps-sidebar { position: fixed; inset: 0 auto 0 0; width: min(292px, 84vw); transform: translateX(-100%); z-index: 30; box-shadow: 16px 0 28px rgba(18,33,60,.14); }\n    .ps-main { min-height: 100vh; }\n    .ps-content { padding: 18px 16px 20px; }\n    .ps-page-heading { margin-bottom: 14px; }\n    .ps-mobile-menu { width: 42px; height: 42px; border: 1px solid var(--ps-line-strong); border-radius: 7px; background: #fff; color: var(--ps-ink); display: grid; place-items: center; }\n    .ps-mobile-menu i { font-size: 18px; }\n    .ps-main-heading { font-size: 24px; }\n    .ps-hero { padding: 17px; }\n    .ps-hero-title { font-size: 17px; }\n    .ps-stat-row { gap: 6px; }\n    .ps-stat { font-size: 10px; }\n    .ps-grid { grid-template-columns: 1fr; gap: 12px; }\n    .ps-card { min-height: 0; }\n    .ps-footer { padding: 13px 16px; display: block; text-align: center; }\n    .ps-footer p + p { margin-top: 4px; }\n  }\n</style>\n<div class=\"ps-page\" data-kid=\"1\">\n    <aside class=\"ps-sidebar\" data-kid=\"1-1\" id=\"sidebar\">\n        <div class=\"ps-brand\" data-kid=\"1-1-1\">\n            <img alt=\"PlusSoft Logo\" data-kid=\"1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/logo-plussoft.png\"/>\n            <div class=\"ps-brand-rule\" data-kid=\"1-1-1-2\">\n            </div>\n        </div>\n        <nav aria-label=\"Categorias de software\" class=\"ps-menu menu\" data-kid=\"1-1-2\">\n            <button class=\"ps-menu-item menu-item active\" data-id=\"plussoft\" data-kid=\"1-1-2-1\">\n                <span class=\"ps-menu-text menu-text\" data-kid=\"1-1-2-1-1\">\n                    Ferramentas PlusSoft\n                </span>\n                <span class=\"ps-menu-chevron menu-chevron\" data-kid=\"1-1-2-1-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"ps-menu-item menu-item\" data-id=\"shop9\" data-kid=\"1-1-2-2\">\n                <span class=\"ps-menu-text menu-text\" data-kid=\"1-1-2-2-1\">\n                    Atualizações do ShopControl9\n                </span>\n                <span class=\"ps-menu-chevron menu-chevron\" data-kid=\"1-1-2-2-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"ps-menu-item menu-item\" data-id=\"remote\" data-kid=\"1-1-2-3\">\n                <span class=\"ps-menu-text menu-text\" data-kid=\"1-1-2-3-1\">\n                    Acesso Remoto\n                </span>\n                <span class=\"ps-menu-chevron menu-chevron\" data-kid=\"1-1-2-3-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"ps-menu-item menu-item\" data-id=\"debug\" data-kid=\"1-1-2-4\">\n                <span class=\"ps-menu-text menu-text\" data-kid=\"1-1-2-4-1\">\n                    Debug Remoto\n                </span>\n                <span class=\"ps-menu-chevron menu-chevron\" data-kid=\"1-1-2-4-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"ps-menu-item menu-item\" data-id=\"links\" data-kid=\"1-1-2-5\">\n                <span class=\"ps-menu-text menu-text\" data-kid=\"1-1-2-5-1\">\n                    Links Úteis\n                </span>\n                <span class=\"ps-menu-chevron menu-chevron\" data-kid=\"1-1-2-5-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"ps-menu-item menu-item\" data-id=\"sql\" data-kid=\"1-1-2-6\">\n                <span class=\"ps-menu-text menu-text\" data-kid=\"1-1-2-6-1\">\n                    SQL Server\n                </span>\n                <span class=\"ps-menu-chevron menu-chevron\" data-kid=\"1-1-2-6-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"ps-menu-item menu-item\" data-id=\"management\" data-kid=\"1-1-2-7\">\n                <span class=\"ps-menu-text menu-text\" data-kid=\"1-1-2-7-1\">\n                    Management Studio\n                </span>\n                <span class=\"ps-menu-chevron menu-chevron\" data-kid=\"1-1-2-7-2\">\n                    ›\n                </span>\n            </button>\n        </nav>\n        <div class=\"ps-sidebar-bottom\" data-kid=\"1-1-3\">\n            <a class=\"ps-login login-btn\" data-kid=\"1-1-3-1\" href=\"https://plussoft.com.br/login\">\n                <i class=\"ti ti-login-2\" data-kid=\"1-1-3-1-1\">\n                </i>\n       