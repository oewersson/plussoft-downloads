      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Sans+3:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n  .ps-page { min-height: 900px; display: grid; grid-template-columns: 232px minmax(0, 1fr); background: #f6f8fb; color: #172033; font-family: 'Source Sans 3', ui-sans-serif, system-ui, sans-serif; }\n  .ps-sidebar { min-height: 900px; display: flex; flex-direction: column; padding: 28px 18px 20px; background: #ffffff; border-right: 1px solid #dce3ec; }\n  .ps-brand { padding: 2px 10px 0; }\n  .ps-brand img { display: block; width: 148px; height: auto; max-width: 100%; }\n  .ps-brand-rule { width: 28px; height: 3px; margin: 42px 0 21px 10px; background: #1746a2; }\n  .menu { display: flex; flex-direction: column; gap: 4px; }\n  .menu-item { position: relative; width: 100%; min-height: 46px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 10px 0 13px; border: 0; border-left: 3px solid transparent; border-radius: 0 6px 6px 0; background: transparent; color: #526075; font-family: 'IBM Plex Sans', sans-serif; font-size: 14px; font-weight: 500; text-align: left; }\n  .menu-item:hover { background: #f4f7fb; color: #172033; }\n  .menu-item.active { border-left-color: #1746a2; background: #edf3ff; color: #1746a2; font-weight: 600; }\n  .menu-item:focus-visible, .btn:focus-visible, .login-btn:focus-visible, .mobile-menu:focus-visible, .modal-close:focus-visible { outline: 2px solid #1746a2; outline-offset: 3px; }\n  .menu-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .menu-chevron { color: #9aa6b5; font-size: 15px; line-height: 1; }\n  .menu-item.active .menu-chevron { color: #1746a2; }\n  .sidebar-bottom { margin-top: auto; padding: 20px 4px 0; border-top: 1px solid #e8edf3; }\n  .login-btn { min-height: 44px; display: flex; align-items: center; justify-content: center; gap: 9px; border-radius: 6px; background: #1746a2; color: #ffffff; font-family: 'IBM Plex Sans', sans-serif; font-size: 13px; font-weight: 600; }\n  .login-btn:hover { background: #103780; }\n  .login-btn i { font-size: 17px; }\n  .ps-main { min-width: 0; min-height: 900px; display: flex; flex-direction: column; }\n  .ps-content { width: min(100%, 1048px); padding: 48px 56px 28px; }\n  .ps-heading { max-width: 690px; }\n  .ps-overline { margin: 0 0 12px; color: #1746a2; font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }\n  .main-heading { margin: 0; color: #172033; font-family: 'IBM Plex Sans', sans-serif; font-size: 34px; line-height: 1.1; font-weight: 600; letter-spacing: -.025em; }\n  .ps-lede { max-width: 610px; margin: 13px 0 0; color: #667085; font-size: 16px; line-height: 1.45; }\n  .search-and-stats { display: flex; align-items: center; gap: 22px; margin-top: 32px; padding-bottom: 19px; border-bottom: 1px solid #dce3ec; }\n  .search-container { width: min(100%, 676px); }\n  .search { min-height: 50px; display: flex; align-items: center; gap: 10px; padding: 0 13px; border: 1px solid #cbd5e1; border-radius: 5px; background: #ffffff; }\n  .search:focus-within { border-color: #1746a2; box-shadow: 0 0 0 3px #edf3ff; }\n  .search-icon { flex: 0 0 auto; width: 19px; height: 19px; color: #738197; font-size: 19px; }\n  .search input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: #172033; font-family: 'Source Sans 3', sans-serif; font-size: 15px; }\n  .search input::placeholder { color: #8b97a8; }\n  .shortcut-badge { padding: 3px 7px; border: 1px solid #dce3ec; border-radius: 3px; background: #f1f4f8; color: #6b7585; font-family: 'IBM Plex Mono', monospace; font-size: 10px; font-weight: 500; white-space: nowrap; }\n  .stat-badge { display: inline-flex; align-items: center; gap: 9px; color: #3a485c; font-family: 'IBM Plex Sans', sans-serif; font-size: 14px; font-weight: 500; white-space: nowrap; }\n  .stat-badge i { color: #1746a2; font-size: 18px; }\n  .section-head { display: flex; align-items: flex-end; gap: 18px; margin: 35px 0 16px; }\n  .section-head h2 { flex: 0 0 auto; margin: 0; color: #172033; font-family: 'IBM Plex Sans', sans-serif; font-size: 22px; line-height: 1.15; font-weight: 600; }\n  .section-rule { flex: 1; height: 1px; margin-bottom: 4px; background: #dce3ec; }\n  .section-head p { display: none; }\n  .grid { display: grid; grid-template-columns: minmax(0, 1.13fr) minmax(0, .87fr); gap: 16px; }\n  .card { min-width: 0; display: flex; flex-direction: column; padding: 20px 21px 18px; border: 1px solid #dce3ec; border-radius: 7px; background: #ffffff; }\n  .card:hover { border-color: #9db4d9; }\n  .card-header { display: flex; align-items: flex-start; gap: 13px; min-width: 0; }\n  .app-icon-img { width: 46px; height: 46px; flex: 0 0 46px; display: grid; place-items: center; border: 1px solid #dce3ec; border-radius: 6px; background: #f6f8fb; object-fit: contain; padding: 7px; }\n  .app-icon-img[src*='program-default-logo'] { opacity: 0; }\n  .app-mark { position: relative; width: 46px; height: 46px; flex: 0 0 46px; display: grid; place-items: center; border: 1px solid #dce3ec; border-radius: 6px; background: #f6f8fb; color: #1746a2; font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 600; }\n  .app-mark::after { content: ''; position: absolute; right: 7px; bottom: 7px; width: 5px; height: 5px; border-radius: 50%; background: #ee4324; }\n  .app-mark.alt { color: #485b79; }\n  .app-mark.alt::after { background: #8da4c7; }\n  .app-info { min-width: 0; flex: 1; padding-top: 2px; }\n  .app-title { margin: 0; color: #172033; font-family: 'IBM Plex Sans', sans-serif; font-size: 17px; line-height: 1.18; font-weight: 600; }\n  .app-category { margin-top: 5px; color: #7a8798; font-size: 12px; line-height: 1.2; }\n  .status { display: none; }\n  .card p { min-height: 42px; margin: 18px 0 16px; color: #667085; font-size: 13px; line-height: 1.45; }\n  .meta { display: grid; grid-template-columns: minmax(90px, .72fr) minmax(0, 1.28fr); gap: 15px; padding: 14px 0 13px; border-top: 1px solid #e7ecf2; border-bottom: 1px solid #e7ecf2; }\n  .meta > div + div { padding-left: 15px; border-left: 1px solid #e7ecf2; }\n  .meta-label { color: #8793a3; font-family: 'IBM Plex Sans', sans-serif; font-size: 10px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; }\n  .meta-value { margin-top: 5px; color: #172033; font-family: 'IBM Plex Mono', monospace; font-size: 12px; font-weight: 500; line-height: 1.3; font-variant-numeric: tabular-nums; white-space: nowrap; }\n  .meta-value.muted { color: #8b97a8; }\n  .card-actions { display: flex; align-items: center; gap: 14px; margin-top: 15px; }\n  .btn { min-height: 38px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; border-radius: 5px; padding: 0 13px; font-family: 'IBM Plex Sans', sans-serif; font-size: 12px; font-weight: 600; }\n  .btn i { font-size: 16px; }\n  .btn-primary { flex: 0 0 auto; min-width: 121px; border: 1px solid #1746a2; background: #1746a2; color: #ffffff; }\n  .btn-primary:hover { background: #103780; }\n  .btn-secondary { flex: 0 0 auto; padding: 0 4px; border: 1px solid transparent; background: transparent; color: #1746a2; }\n  .btn-secondary:hover { color: #103780; text-decoration: underline; text-underline-offset: 3px; }\n  .ps-reference-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.16fr); gap: 16px; margin-top: 25px; }\n  .ps-reference-label { margin: 0 0 9px; color: #8b97a8; font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }\n  .ps-empty-specimen { min-height: 132px; display: flex; flex-direction: column; justify-content: center; padding: 17px 19px; border: 1px solid #dce3ec; border-radius: 7px; background: #ffffff; }\n  .ps-empty-specimen strong { color: #344255; font-family: 'IBM Plex Sans', sans-serif; font-size: 14px; font-weight: 600; }\n  .ps-empty-specimen span { max-width: 260px; margin-top: 5px; color: #7b8796; font-size: 12px; line-height: 1.35; }\n  .ps-empty-mark { width: 28px; height: 28px; display: grid; place-items: center; margin-bottom: 10px; border: 1px solid #dce3ec; border-radius: 5px; color: #7b8796; background: #f6f8fb; font-size: 16px; }\n  .modal-reference { min-height: 132px; padding: 14px 17px 10px; border: 1px solid #d6deea; border-radius: 7px; background: #ffffff; box-shadow: 0 8px 20px rgba(23,32,51,.08); }\n  .modal-reference .modal-header { display: flex; align-items: center; gap: 10px; padding-bottom: 10px; border-bottom: 1px solid #e7ecf2; }\n  .modal-reference .modal-icon { width: 28px; height: 28px; display: grid; place-items: center; border: 1px solid #dce3ec; border-radius: 4px; color: #1746a2; background: #f6f8fb; font-family: 'IBM Plex Mono', monospace; font-size: 9px; font-weight: 600; }\n  .modal-reference .modal-title { margin: 0; color: #172033; font-family: 'IBM Plex Sans', sans-serif; font-size: 13px; font-weight: 600; }\n  .modal-reference .modal-category { display: block; margin-top: 1px; color: #7c8898; font-size: 10px; }\n  .modal-close { margin-left: auto; border: 0; background: transparent; color: #7b8796; font-size: 15px; }\n  .modal-body { padding-top: 9px; }\n  .modal-desc { margin: 0 0 5px; color: #687587; font-size: 10px; }\n  #modalVersions { border-top: 1px solid #e7ecf2; }\n  #modalVersions ul { margin: 0 !important; padding: 0 !important; list-style: none !important; }\n  #modalVersions li { display: flex !important; align-items: center; justify-content: space-between; gap: 10px; padding: 7px 0 !important; border-bottom: 1px solid #edf0f4 !important; color: #172033; font-family: 'IBM Plex Mono', monospace; font-size: 10px; }\n  #modalVersions li strong { font-weight: 600; }\n  #modalVersions li span { color: #7b8796 !important; font-size: 9px !important; }\n  #modalVersions li .btn { min-height: 21px; min-width: auto; padding: 0 7px !important; border-radius: 3px; font-size: 9px !important; }\n  .empty { display: none; }\n  .app-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: auto; padding: 17px 56px; border-top: 1px solid #dce3ec; color: #8793a3; font-size: 11px; }\n  .app-footer p { margin: 0; }\n  .app-footer p:last-child { text-align: right; }\n  @media (max-width: 880px) {\n    .ps-page { grid-template-columns: 210px minmax(0, 1fr); }\n    .ps-content { padding: 38px 34px 24px; }\n    .grid { grid-template-columns: 1fr; }\n    .ps-reference-row { grid-template-columns: 1fr; }\n    .app-footer { padding-left: 34px; padding-right: 34px; }\n  }\n</style>\n<div class=\"ps-page\" data-kid=\"1\">\n    <aside class=\"ps-sidebar\" data-kid=\"1-1\" id=\"sidebar\">\n        <div class=\"ps-brand\" data-kid=\"1-1-1\">\n            <img alt=\"PlusSoft\" data-kid=\"1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/logo-plussoft.png\"/>\n        </div>\n        <div aria-hidden=\"true\" class=\"ps-brand-rule\" data-kid=\"1-1-2\">\n        </div>\n        <nav aria-label=\"Categorias de produtos\" class=\"menu\" data-kid=\"1-1-3\">\n            <button class=\"menu-item active\" data-id=\"1\" data-kid=\"1-1-3-1\">\n                <span class=\"menu-text\" data-kid=\"1-1-3-1-1\">\n                    Ferramentas PlusSoft\n                </span>\n                <span class=\"menu-chevron\" data-kid=\"1-1-3-1-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"menu-item\" data-id=\"2\" data-kid=\"1-1-3-2\">\n                <span class=\"menu-text\" data-kid=\"1-1-3-2-1\">\n                    Ferramentas SQL\n                </span>\n                <span class=\"menu-chevron\" data-kid=\"1-1-3-2-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"menu-item\" data-id=\"3\" data-kid=\"1-1-3-3\">\n                <span class=\"menu-text\" data-kid=\"1-1-3-3-1\">\n                    IdealSoft\n                </span>\n                <span class=\"menu-chevron\" data-kid=\"1-1-3-3-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"menu-item\" data-id=\"4\" data-kid=\"1-1-3-4\">\n                <span class=\"menu-text\" data-kid=\"1-1-3-4-1\">\n                    Links Úteis\n                </span>\n                <span class=\"menu-chevron\" data-kid=\"1-1-3-4-2\">\n                    ›\n                </span>\n            </button>\n        </nav>\n        <div class=\"sidebar-bottom\" data-kid=\"1-1-4\">\n            <a class=\"login-btn\" data-kid=\"1-1-4-1\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-login-2\" data-kid=\"1-1-4-1-1\">\n                </i>\n                <span data-kid=\"1-1-4-1-2\">\n                    Fazer Login\n                </span>\n            </a>\n        </div>\n    </aside>\n    <main class=\"ps-main\" data-kid=\"1-2\">\n        <div class=\"ps-content\" data-kid=\"1-2-1\">\n            <header class=\"ps-heading\" data-kid=\"1-2-1-1\">\n                <p class=\"ps-overline\" data-kid=\"1-2-1-1-1\">\n                    Central oficial de software\n                </p>\n                <h1 class=\"main-heading\" data-kid=\"1-2-1-1-2\">\n                    Programas e atualizações\n                </h1>\n                <p class=\"ps-lede\" data-kid=\"1-2-1-1-3\">\n                    Downloads oficiais, ferramentas e versões atualizadas dos produtos PlusSoft.\n                </p>\n            </header>\n            <div class=\"search-and-stats\" data-kid=\"1-2-1-2\">\n                <div class=\"search-container\" data-kid=\"1-2-1-2-1\">\n                    <label class=\"sr-only\" data-kid=\"1-2-1-2-1-1\" for=\"searchInput\">\n                        Buscar programa, versão ou produto\n                    </label>\n                    <div class=\"search\" data-kid=\"1-2-1-2-1-2\">\n                        <i aria-hidden=\"true\" class=\"ti ti-search search-icon\" data-kid=\"1-2-1-2-1-2-1\">\n                        </i>\n                        <input data-kid=\"1-2-1-2-1-2-2\" id=\"searchInput\" placeholder=\"Buscar programa, versão ou produto\"/>\n                        <span class=\"shortcut-badge\" data-kid=\"1-2-1-2-1-2-3\">\n                            Enter ↵\n                        </span>\n                    </div>\n                </div>\n                <span class=\"stat-badge outline\" data-kid=\"1-2-1-2-2\" id=\"summaryCountContainer\">\n                    <i aria-hidden=\"true\" class=\"ti ti-package\" data-kid=\"1-2-1-2-2-1\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-2-2\">\n                        <strong data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"summary count text\" data-reason=\"number text updated by search filtering script\" id=\"summaryCount\">\n                            2\n                        </strong>\n                        programas disponíveis\n                    </span>\n                </span>\n            </div>\n            <section class=\"section-head\" data-kid=\"1-2-1-3\">\n                <h2 data-dynamic=\"true\" data-kid=\"1-2-1-3-1\" data-name=\"section title text\" data-reason=\"text updated by category selection script\" id=\"sectionTitle\">\n                    Ferramentas PlusSoft\n                </h2>\n                <div aria-hidden=\"true\" class=\"section-rule\" data-kid=\"1-2-1-3-2\">\n                </div>\n            </section>\n            <section class=\"grid\" data-dynamic=\"true\" data-kid=\"1-2-1-4\" data-name=\"software program grid container\" data-reason=\"content rendered/injected by search filtering script\" id=\"grid\">\n                <article class=\"card\" data-kid=\"1-2-1-4-1\">\n                    <div class=\"card-header\" data-kid=\"1-2-1-4-1-1\">\n                        <div aria-label=\"Logo FotoPlus\" class=\"app-mark\" data-kid=\"1-2-1-4-1-1-1\">\n                            FP\n                        </div>\n                        <div class=\"app-info\" data-kid=\"1-2-1-4-1-1-2\">\n                            <h3 class=\"app-title\" data-kid=\"1-2-1-4-1-1-2-1\">\n                                FotoPlus\n                            </h3>\n                            <div class=\"app-category\" data-kid=\"1-2-1-4-1-1-2-2\">\n                                Ferramentas PlusSoft\n                            </div>\n                        </div>\n                    </div>\n                    <p data-kid=\"1-2-1-4-1-2\">\n                        Aplicativo integrado para organizar e operar fluxos de imagem da equipe.\n                    </p>\n                    <div class=\"meta\" data-kid=\"1-2-1-4-1-3\">\n                        <div data-kid=\"1-2-1-4-1-3-1\">\n                            <div class=\"meta-label\" data-kid=\"1-2-1-4-1-3-1-1\">\n                                Versão atual\n                            </div>\n                            <div class=\"meta-value\" data-kid=\"1-2-1-4-1-3-1-2\">\n                                1.1.1\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-1-4-1-3-2\">\n                            <div class=\"meta-label\" data-kid=\"1-2-1-4-1-3-2-1\">\n                                Atualizado em\n                            </div>\n                            <div class=\"meta-value\" data-kid=\"1-2-1-4-1-3-2-2\">\n                                15/09/2026 • 14:35\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card-actions\" data-kid=\"1-2-1-4-1-4\">\n                        <a class=\"btn btn-primary\" data-kid=\"1-2-1-4-1-4-1\" href=\"#\">\n                            <i aria-hidden=\"true\" class=\"ti ti-download\" data-kid=\"1-2-1-4-1-4-1-1\">\n                            </i>\n                            Download\n                        </a>\n                        <button class=\"btn btn-secondary\" data-kid=\"1-2-1-4-1-4-2\">\n                            Detalhes\n                            <i aria-hidden=\"true\" class=\"ti ti-chevron-right\" data-kid=\"1-2-1-4-1-4-2-1\">\n                            </i>\n                        </button>\n                    </div>\n                </article>\n                <article class=\"card\" data-kid=\"1-2-1-4-2\">\n                    <div class=\"card-header\" data-kid=\"1-2-1-4-2-1\">\n                        <div aria-label=\"Logo PlusColetor\" class=\"app-mark alt\" data-kid=\"1-2-1-4-2-1-1\">\n                            PC\n                        </div>\n                        <div class=\"app-info\" data-kid=\"1-2-1-4-2-1-2\">\n                            <h3 class=\"app-title\" data-kid=\"1-2-1-4-2-1-2-1\">\n                                PlusColetor\n                            </h3>\n                            <div class=\"app-category\" data-kid=\"1-2-1-4-2-1-2-2\">\n                                Ferramentas PlusSoft\n                            </div>\n                        </div>\n                    </div>\n                    <p data-kid=\"1-2-1-4-2-2\">\n                        Aplicativo integrado para coleta e sincronização de informações operacionais.\n                    </p>\n                    <div class=\"meta\" data-kid=\"1-2-1-4-2-3\">\n                        <div data-kid=\"1-2-1-4-2-3-1\">\n                            <div class=\"meta-label\" data-kid=\"1-2-1-4-2-3-1-1\">\n                                Versão atual\n                            </div>\n                            <div class=\"meta-value muted\" data-kid=\"1-2-1-4-2-3-1-2\">\n                                Não informado\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-1-4-2-3-2\">\n                            <div class=\"meta-label\" data-kid=\"1-2-1-4-2-3-2-1\">\n                                Atualizado em\n                            </div>\n                            <div class=\"meta-value muted\" data-kid=\"1-2-1-4-2-3-2-2\">\n                                —\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card-actions\" data-kid=\"1-2-1-4-2-4\">\n                        <a class=\"btn btn-primary\" data-kid=\"1-2-1-4-2-4-1\" href=\"#\">\n                            <i aria-hidden=\"true\" class=\"ti ti-download\" data-kid=\"1-2-1-4-2-4-1-1\">\n                            </i>\n                            Download\n                        </a>\n                        <button class=\"btn btn-secondary\" data-kid=\"1-2-1-4-2-4-2\">\n                            Detalhes\n                            <i aria-hidden=\"true\" class=\"ti ti-chevron-right\" data-kid=\"1-2-1-4-2-4-2-1\">\n                            </i>\n                        </button>\n                    </div>\n                </article>\n            </section>\n            <div aria-label=\"Referências de estados da interface\" class=\"ps-reference-row\" data-kid=\"1-2-1-5\">\n                <div data-kid=\"1-2-1-5-1\">\n                    <p class=\"ps-reference-label\" data-kid=\"1-2-1-5-1-1\">\n                        Estado sem resultados\n                    </p>\n                    <div class=\"ps-empty-specimen\" data-dynamic=\"true\" data-kid=\"1-2-1-5-1-2\" data-name=\"empty search results container\" data-reason=\"visibility toggled by search filtering script\" id=\"emptyState\">\n                        <div class=\"ps-empty-mark\" data-kid=\"1-2-1-5-1-2-1\">\n                            <i aria-hidden=\"true\" class=\"ti ti-file-search\" data-kid=\"1-2-1-5-1-2-1-1\">\n                            </i>\n                        </div>\n                        <strong data-kid=\"1-2-1-5-1-2-2\">\n                            Nenhum programa encontrado\n                        </strong>\n                        <span data-kid=\"1-2-1-5-1-2-3\">\n                            Tente outro termo ou escolha uma categoria diferente.\n                        </span>\n                    </div>\n                </div>\n                <div data-kid=\"1-2-1-5-2\">\n                    <p class=\"ps-reference-label\" data-kid=\"1-2-1-5-2-1\">\n                        Histórico de versões\n                    </p>\n                    <div aria-label=\"Prévia do histórico de versões\" class=\"modal-reference\" data-dynamic=\"true\" data-kid=\"1-2-1-5-2-2\" data-name=\"software details modal\" data-reason=\"content rendered/injected by details modal script\" id=\"detailsModal\">\n                        <div class=\"modal-header\" data-kid=\"1-2-1-5-2-2-1\">\n                            <div class=\"modal-icon\" data-dynamic=\"true\" data-kid=\"1-2-1-5-2-2-1-1\" data-name=\"modal app icon mark\" data-reason=\"text/color/attributes updated by details modal script\">\n                                FP\n                            </div>\n                            <div data-kid=\"1-2-1-5-2-2-1-2\">\n                                <h3 class=\"modal-title\" data-dynamic=\"true\" data-kid=\"1-2-1-5-2-2-1-2-1\" data-name=\"modal title text\" data-reason=\"text updated by details modal script\" id=\"modalTitle\">\n                                    FotoPlus\n                                </h3>\n                                <span class=\"modal-category\" data-dynamic=\"true\" data-kid=\"1-2-1-5-2-2-1-2-2\" data-name=\"modal category text\" data-reason=\"text updated by details modal script\" id=\"modalCategory\">\n                                    Ferramentas PlusSoft\n                                </span>\n                            </div>\n                            <button aria-label=\"Fechar\" class=\"modal-close\" data-kid=\"1-2-1-5-2-2-1-3\" id=\"closeModal\">\n                                <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"1-2-1-5-2-2-1-3-1\">\n                                </i>\n                            </button>\n                        </div>\n                        <div class=\"modal-body\" data-kid=\"1-2-1-5-2-2-2\">\n                            <p class=\"modal-desc\" data-kid=\"1-2-1-5-2-2-2-1\" id=\"modalDesc\">\n                                Histórico de versões\n                            </p>\n                            <div data-dynamic=\"true\" data-kid=\"1-2-1-5-2-2-2-2\" data-name=\"modal version list container\" data-reason=\"list items rendered/injected by details modal script\" id=\"modalVersions\">\n                                <ul data-kid=\"1-2-1-5-2-2-2-2-1\">\n                                    <li data-kid=\"1-2-1-5-2-2-2-2-1-1\">\n                                        <strong data-kid=\"1-2-1-5-2-2-2-2-1-1-1\">\n                                            v1.2.0\n                                        </strong>\n                                        <span data-kid=\"1-2-1-5-2-2-2-2-1-1-2\">\n                                            15/09/2026 • 14:35\n                                        </span>\n                                        <button class=\"btn btn-primary\" data-kid=\"1-2-1-5-2-2-2-2-1-1-3\">\n                                            Baixar\n                                        </button>\n                                    </li>\n                                    <li data-kid=\"1-2-1-5-2-2-2-2-1-2\">\n                                        <strong data-kid=\"1-2-1-5-2-2-2-2-1-2-1\">\n                                            1.1.1\n                                        </strong>\n                                        <span data-kid=\"1-2-1-5-2-2-2-2-1-2-2\">\n                                            02/08/2026\n                                        </span>\n                                        <span data-kid=\"1-2-1-5-2-2-2-2-1-2-3\">\n                                        </span>\n                                    </li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <footer class=\"app-footer\" data-kid=\"1-2-2\">\n            <p data-kid=\"1-2-2-1\">\n                PlusSoft © 2026. Todos os direitos reservados.\n            </p>\n            <p data-kid=\"1-2-2-2\">\n                Rua Antonio Marroquim, 529 · Baixão · Arapiraca / Alagoas\n            </p>\n        </footer>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-09-17T18:02:23.273236+00:00",
