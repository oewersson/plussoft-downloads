r')\" type=\"button\">\n                                Detalhes\n                                <i aria-hidden=\"true\" class=\"ti ti-chevron-right\" data-kid=\"1-1-2-1-5-2-4-2-1\">\n                                </i>\n                            </button>\n                        </div>\n                    </article>\n                </section>\n                <div class=\"empty\" data-dynamic=\"true\" data-kid=\"1-1-2-1-6\" data-name=\"empty state message container\" data-reason=\"visibility toggled by script\" id=\"emptyState\">\n                    <i aria-hidden=\"true\" class=\"ti ti-file-search\" data-kid=\"1-1-2-1-6-1\">\n                    </i>\n                    <div class=\"empty-copy\" data-kid=\"1-1-2-1-6-2\">\n                        <strong data-kid=\"1-1-2-1-6-2-1\">\n                            Nenhum programa encontrado\n                        </strong>\n                        <span data-kid=\"1-1-2-1-6-2-2\">\n                            Ao buscar sem correspondência, tente outro nome ou escolha uma categoria.\n                        </span>\n                    </div>\n                    <span class=\"empty-note\" data-kid=\"1-1-2-1-6-3\">\n                        estado alternativo\n                    </span>\n                </div>\n                <div class=\"secondary-specimens\" data-kid=\"1-1-2-1-7\">\n                    <div data-kid=\"1-1-2-1-7-1\">\n                    </div>\n                    <div data-kid=\"1-1-2-1-7-2\">\n                        <p class=\"specimen-label\" data-kid=\"1-1-2-1-7-2-1\">\n                            Modal de detalhes · histórico\n                        </p>\n                        <div class=\"modal-overlay static-specimen\" data-dynamic=\"true\" data-kid=\"1-1-2-1-7-2-2\" data-name=\"details modal\" data-reason=\"visibility/content updated by script\" id=\"detailsModal\">\n                            <div class=\"modal-content\" data-kid=\"1-1-2-1-7-2-2-1\">\n                                <button aria-label=\"Fechar histórico\" class=\"modal-close\" data-kid=\"1-1-2-1-7-2-2-1-1\" id=\"closeModal\" type=\"button\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"1-1-2-1-7-2-2-1-1-1\">\n                                    </i>\n                                </button>\n                                <div class=\"modal-header\" data-kid=\"1-1-2-1-7-2-2-1-2\">\n                                    <div aria-hidden=\"true\" class=\"modal-icon\" data-dynamic=\"true\" data-kid=\"1-1-2-1-7-2-2-1-2-1\" data-name=\"modal icon\" data-reason=\"icon replaced by script\" id=\"modalIcon\">\n                                        F\n                                    </div>\n                                    <div data-kid=\"1-1-2-1-7-2-2-1-2-2\">\n                                        <h3 class=\"modal-title\" data-dynamic=\"true\" data-kid=\"1-1-2-1-7-2-2-1-2-2-1\" data-name=\"modal title\" data-reason=\"text replaced by script\" id=\"modalTitle\">\n                                            FotoPlus\n                                        </h3>\n                                        <span class=\"modal-category\" data-dynamic=\"true\" data-kid=\"1-1-2-1-7-2-2-1-2-2-2\" data-name=\"modal category\" data-reason=\"text replaced by script\" id=\"modalCategory\">\n                                            Ferramentas PlusSoft\n                                        </span>\n                                    </div>\n                                </div>\n                                <div class=\"modal-body\" data-kid=\"1-1-2-1-7-2-2-1-3\">\n                                    <p class=\"modal-desc\" data-kid=\"1-1-2-1-7-2-2-1-3-1\" id=\"modalDesc\">\n                                        Histórico de versões\n                                    </p>\n                                    <div data-dynamic=\"true\" data-kid=\"1-1-2-1-7-2-2-1-3-2\" data-name=\"modal version list container\" data-reason=\"list items injected by script\" id=\"modalVersions\">\n                                        <ul data-dynamic=\"true\" data-kid=\"1-1-2-1-7-2-2-1-3-2-1\" data-name=\"modal versions list\" data-reason=\"list items injected by script\">\n                                            <li data-kid=\"1-1-2-1-7-2-2-1-3-2-1-1\">\n                                                <div data-kid=\"1-1-2-1-7-2-2-1-3-2-1-1-1\">\n                                                    <strong data-kid=\"1-1-2-1-7-2-2-1-3-2-1-1-1-1\">\n                                                        v1.2.0\n                                                    </strong>\n                                                    <span data-kid=\"1-1-2-1-7-2-2-1-3-2-1-1-1-2\">\n                                                        15/09/2026\n                                                    </span>\n                                                </div>\n                                                <a data-kid=\"1-1-2-1-7-2-2-1-3-2-1-1-2\" href=\"#version\">\n                                                    Baixar\n                                                </a>\n                                            </li>\n                                            <li data-kid=\"1-1-2-1-7-2-2-1-3-2-1-2\">\n                                                <div data-kid=\"1-1-2-1-7-2-2-1-3-2-1-2-1\">\n                                                    <strong data-kid=\"1-1-2-1-7-2-2-1-3-2-1-2-1-1\">\n                                                        1.1.1\n                                                    </strong>\n                                                    <span data-kid=\"1-1-2-1-7-2-2-1-3-2-1-2-1-2\">\n                                                        06/08/2026\n                                                    </span>\n                                                </div>\n                                                <a data-kid=\"1-1-2-1-7-2-2-1-3-2-1-2-2\" href=\"#version\">\n                                                    Baixar\n                                                </a>\n                                            </li>\n                                        </ul>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <footer class=\"app-footer\" data-kid=\"1-1-2-2\">\n                <p data-kid=\"1-1-2-2-1\">\n                    PlusSoft © 2026. Todos os direitos reservados.\n                </p>\n                <p data-kid=\"1-1-2-2-2\">\n                    Rua Antonio Marroquim, 529 Baixão Arapiraca / Alagoas\n                </p>\n            </footer>\n        </main>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-09-17T18:02:30.284127+00:00",
      "modified": "2026-09-17T18:03:17.066114+00:00",
      "id": "var_df813cb853c9"
    },
    "var_b6570acfedfd": {
      "type": "variant",
      "label": "PlusSoft — Workspace contextual",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&family=Space+Mono:wght@400;700&family=Work+Sans:wght@400;500;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/tabler-icons.min.css');\n\n  .plussoft-page {\n    --page: #f4f6f9;\n    --panel: #ffffff;\n    --panel-soft: #f9fbfe;\n    --ink: #111e43;\n    --muted: #6b7585;\n    --quiet: #8a94a3;\n    --line: #d7dfea;\n    --line-soft: #e8edf3;\n    --blue: #214aa6;\n    --blue-deep: #17377f;\n    --blue-soft: #e9f0fd;\n    --orange: #ef472b;\n    --warning: #9a543e;\n    min-height: 100vh;\n    background: var(--page);\n    color: var(--ink);\n    font-family: 'Work Sans', ui-sans-serif, system-ui, sans-serif;\n  }\n  .plussoft-page h1,\n  .plussoft-page h2,\n  .plussoft-page h3,\n  .plussoft-page p {\n    margin: 0;\n  }\n  .plussoft-page button,\n  .plussoft-page input {\n    font: inherit;\n  }\n  .plussoft-page a {\n    color: inherit;\n    text-decoration: none;\n  }\n  .shell-sidebar {\n    width: 224px;\n    flex: 0 0 224px;\n    min-height: 100vh;\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    background: var(--panel);\n    border-right: 1px solid var(--line);\n    padding: 28px 18px 22px;\n  }\n  .brand-block {\n    padding: 0 10px;\n  }\n  .brand-block img {\n    display: block;\n    width: 148px;\n    height: auto;\n    max-width: 100%;\n  }\n  .brand-note {\n    margin-top: 13px;\n    color: var(--quiet);\n    font-family: 'Space Mono', monospace;\n    font-size: 9px;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n  }\n  .brand-rule {\n    width: 24px;\n    height: 2px;\n    margin: 25px 10px 28px;\n    background: var(--blue);\n  }\n  .menu {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n  }\n  .menu-item {\n    min-height: 44px;\n    width: 100%;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 0 11px 0 13px;\n    border: 1px solid transparent;\n    border-left: 2px solid transparent;\n    border-radius: 0 6px 6px 0;\n    color: #2b3852;\n    background: transparent;\n    text-align: left;\n    cursor: pointer;\n  }\n  .menu-item:hover {\n    background: #f5f7fb;\n  }\n  .menu-item:focus-visible {\n    outline: 2px solid var(--blue);\n    outline-offset: 2px;\n  }\n  .menu-item.active {\n    border-left-color: var(--blue);\n    background: var(--blue-soft);\n    color: var(--blue);\n  }\n  .menu-text {\n    flex: 1;\n    font-family: 'Manrope', sans-serif;\n    font-size: 12px;\n    font-weight: 600;\n    line-height: 1.2;\n  }\n  .menu-item:not(.active) .menu-text {\n    font-weight: 500;\n  }\n  .menu-chevron {\n    color: #a8b2c1;\n    font-size: 18px;\n    line-height: 1;\n    transform: translateY(-1px);\n  }\n  .menu-item.active .menu-chevron,\n  .menu-item:hover .menu-chevron {\n    color: var(--blue);\n  }\n  .sidebar-bottom {\n    margin-top: auto;\n    padding: 22px 2px 0;\n    border-top: 1px solid var(--line-soft);\n  }\n  .sidebar-bottom::before {\n    content: 'Acesso PlusSoft';\n    display: block;\n    margin: 0 10px 11px;\n    color: var(--quiet);\n    font-family: 'Space Mono', monospace;\n    font-size: 9px;\n    letter-spacing: .02em;\n  }\n  .login-btn {\n    min-height: 43px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    border-radius: 6px;\n    background: var(--blue);\n    color: #fff;\n    font-family: 'Manrope', sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n  }\n  .login-btn:hover {\n    background: var(--blue-deep);\n  }\n  .login-btn:focus-visible {\n    outline: 2px solid var(--blue);\n    outline-offset: 3px;\n  }\n  .login-btn i {\n    font-size: 17px;\n    font-weight: 400;\n  }\n  .shell-main {\n    min-width: 0;\n    flex: 1;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n  }\n  .main-inner {\n    width: 100%;\n    max-width: 1160px;\n    margin: 0 auto;\n    padding: 44px 48px 28px;\n  }\n  .page-heading {\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n  }\n  .heading-mark {\n    width: 3px;\n    height: 55px;\n    flex: 0 0 3px;\n    margin-top: 3px;\n    background: var(--blue);\n  }\n  .main-heading {\n    color: var(--ink);\n    font-family: 'Manrope', sans-serif;\n    font-size: 30px;\n    font-weight: 700;\n    letter-spacing: -.035em;\n    line-height: 1.15;\n  }\n  .heading-description {\n    max-width: 620px;\n    margin-top: 10px !important;\n    color: var(--muted);\n    font-size: 14px;\n    line-height: 1.55;\n  }\n  .workbar {\n    display: flex;\n    align-items: center;\n    gap: 24px;\n    margin-top: 31px;\n    padding-bottom: 18px;\n    border-bottom: 1px solid var(--line);\n  }\n  .search-container {\n    flex: 1;\n    min-width: 0;\n    max-width: 680px;\n  }\n  .search {\n    min-height: 49px;\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    padding: 0 12px 0 15px;\n    background: var(--panel);\n    border: 1px solid var(--line);\n    border-radius: 6px;\n  }\n  .search:focus-within {\n    border-color: var(--blue);\n    box-shadow: 0 0 0 2px rgba(33, 74, 166, .12);\n  }\n  .search-icon {\n    color: #79879b;\n    font-size: 19px;\n    line-height: 1;\n  }\n  .search input {\n    min-width: 0;\n    flex: 1;\n    border: 0;\n    outline: none;\n    background: transparent;\n    color: var(--ink);\n    font-size: 14px;\n  }\n  .search input::placeholder {\n    color: #97a2b1;\n  }\n  .shortcut-badge {\n    flex: 0 0 auto;\n    padding: 4px 7px;\n    border: 1px solid var(--line);\n    border-radius: 4px;\n    background: #f1f4f8;\n    color: #718096;\n    font-family: 'Space Mono', monospace;\n    font-size: 10px;\n    line-height: 1;\n  }\n  .stat-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    min-height: 49px;\n    padding: 0 2px 0 23px;\n    border: 0;\n    border-left: 1px solid var(--line);\n    outline: none;\n    color: var(--muted);\n    font-size: 13px;\n    white-space: nowrap;\n  }\n  .stat-badge.outline {\n    outline: none;\n  }\n  .stat-badge i {\n    color: var(--blue);\n    font-size: 17px;\n  }\n  .stat-badge strong {\n    color: var(--ink);\n    font-family: 'Space Mono', monospace;\n    font-size: 13px;\n    font-weight: 700;\n  }\n  .content-layout {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 220px;\n    gap: 44px;\n    align-items: start;\n    margin-top: 33px;\n  }\n  .collection {\n    min-width: 0;\n  }\n  .section-head {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 16px;\n    padding-bottom: 13px;\n    border-bottom: 1px solid var(--line);\n  }\n  .section-head h2 {\n    color: var(--ink);\n    font-family: 'Manrope', sans-serif;\n    font-size: 19px;\n    font-weight: 700;\n    letter-spacing: -.02em;\n  }\n  .section-head p {\n    color: var(--quiet);\n    font-size: 11px;\n    text-align: right;\n  }\n  .grid {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    padding-top: 13px;\n  }\n  .card {\n    display: grid;\n    grid-template-columns: minmax(205px, 1.35fr) minmax(85px, .62fr) minmax(132px, .9fr) auto;\n    align-items: center;\n    min-height: 161px;\n    padding: 21px 20px 21px 22px;\n    background: var(--panel);\n    border: 1px solid var(--line);\n    border-radius: 8px;\n  }\n  .card:hover {\n    border-color: #a9bde2;\n    background: #fcfdff;\n  }\n  .card:focus-within {\n    border-color: var(--blue);\n    box-shadow: 0 0 0 2px rgba(33, 74, 166, .10);\n  }\n  .identity-zone {\n    min-width: 0;\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n    padding-right: 18px;\n  }\n  .app-icon-img {\n    width: 50px;\n    height: 50px;\n    flex: 0 0 50px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--line);\n    border-radius: 7px;\n    background: #f7f9fc;\n    color: var(--blue);\n    font-family: 'Manrope', sans-serif;\n    font-size: 20px;\n    font-weight: 700;\n  }\n  .app-mark-f {\n    color: #ef472b;\n    background: #fff7f4;\n  }\n  .app-mark-p {\n    color: var(--blue);\n    background: var(--blue-soft);\n  }\n  .app-info {\n    min-width: 0;\n    padding-top: 2px;\n  }\n  .app-title {\n    color: var(--ink);\n    font-family: 'Manrope', sans-serif;\n    font-size: 16px;\n    font-weight: 700;\n    letter-spacing: -.015em;\n    line-height: 1.25;\n  }\n  .app-category {\n    display: none;\n  }\n  .app-summary {\n    max-width: 210px;\n    margin-top: 7px !important;\n    color: var(--muted);\n    font-size: 12px;\n    line-height: 1.45;\n  }\n  .status {\n    display: none;\n  }\n  .data-zone {\n    min-height: 58px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 0 17px;\n    border-left: 1px solid var(--line-soft);\n  }\n  .meta-label {\n    color: #8a94a3;\n    font-family: 'Space Mono', monospace;\n    font-size: 9px;\n    letter-spacing: .055em;\n    line-height: 1.3;\n    text-transform: uppercase;\n  }\n  .meta-value {\n    margin-top: 8px;\n    color: var(--ink);\n    font-family: 'Space Mono', monospace;\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1.35;\n    white-space: nowrap;\n  }\n  .update-zone .meta-value {\n    font-size: 11px;\n    font-weight: 400;\n  }\n  .update-zone .meta-value .time {\n    color: var(--muted);\n  }\n  .card-actions {\n    min-width: 110px;\n    display: flex;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 8px;\n    padding-left: 17px;\n  }\n  .btn {\n    min-height: 37px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n    border-radius: 5px;\n    font-family: 'Manrope', sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    white-space: nowrap;\n    cursor: pointer;\n  }\n  .btn i {\n    font-size: 15px;\n    font-weight: 400;\n  }\n  .btn-primary {\n    min-width: 108px;\n    padding: 0 12px;\n    border: 1px solid var(--blue);\n    background: var(--blue);\n    color: #fff;\n  }\n  .plussoft-page a.login-btn,\n  .plussoft-page a.btn-primary {\n    color: #fff;\n  }\n  .btn-primary:hover {\n    border-color: var(--blue-deep);\n    background: var(--blue-deep);\n  }\n  .btn-primary:focus-visible,\n  .btn-secondary:focus-visible {\n    outline: 2px solid var(--blue);\n    outline-offset: 2px;\n  }\n  .btn-secondary {\n    min-width: 108px;\n    padding: 0 10px;\n    border: 1px solid transparent;\n    background: transparent;\n    color: var(--blue);\n  }\n  .btn-secondary:hover {\n    border-color: var(--line);\n    background: #f7f9fc;\n  }\n  .card--missing .meta-value {\n    color: var(--quiet);\n    font-family: 'Work Sans', sans-serif;\n    font-size: 12px;\n    font-weight: 500;\n  }\n  .card--missing .update-zone .meta-value {\n    max-width: 120px;\n    white-space: normal;\n    line-height: 1.35;\n  }\n  .context-panel {\n    min-width: 0;\n    padding-top: 3px;\n    border-top: 2px solid var(--blue);\n  }\n  .context-eyebrow {\n    margin-top: 17px !important;\n    color: var(--quiet);\n    font-family: 'Space Mono', monospace;\n    font-size: 9px;\n    letter-spacing: .10em;\n    text-transform: uppercase;\n  }\n  .context-panel h3 {\n    margin-top: 12px !important;\n    color: var(--ink);\n    font-family: 'Manrope', sans-serif;\n    font-size: 16px;\n    font-weight: 700;\n    line-height: 1.25;\n  }\n  .context-count {\n    margin-top: 22px !important;\n    padding: 13px 0 14px;\n    border-top: 1px solid var(--line);\n    border-bottom: 1px solid var(--line);\n    color: var(--muted);\n    font-size: 12px;\n    line-height: 1.4;\n  }\n  .context-count strong {\n    color: var(--ink);\n    font-family: 'Space Mono', monospace;\n    font-size: 16px;\n  }\n  .context-copy {\n    margin-top: 18px !important;\n    color: var(--muted);\n    font-size: 12px;\n    line-height: 1.6;\n  }\n  .context-rule {\n    width: 34px;\n    height: 1px;\n    margin-top: 31px;\n    background: var(--line);\n  }\n  .empty {\n    display: none;\n  }\n  .app-footer {\n    margin-top: auto;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    padding: 17px 48px 20px;\n    border-top: 1px solid var(--line);\n    color: var(--quiet);\n    font-size: 11px;\n  }\n  .app-footer p {\n    margin: 0;\n  }\n  .modal-overlay {\n    display: none;\n  }\n  @media (max-width: 1020px) {\n    .main-inner {\n      padding-left: 34px;\n      padding-right: 34px;\n    }\n    .content-layout {\n      grid-template-columns: minmax(0, 1fr) 188px;\n      gap: 28px;\n    }\n    .card {\n      grid-template-columns: minmax(180px, 1.3fr) 84px minmax(122px, .9fr);\n    }\n    .card-actions {\n      grid-column: 1 / -1;\n      flex-direction: row;\n      justify-content: flex-end;\n      padding: 15px 0 0;\n      border-top: 1px solid var(--line-soft);\n      margin-top: 16px;\n    }\n  }\n  @media (max-width: 760px) {\n    .plussoft-page {\n      display: block;\n    }\n    .shell-sidebar {\n      width: min(280px, 86vw);\n      position: fixed;\n      inset: 0 auto 0 0;\n      z-index: 20;\n      transform: translateX(-100%);\n      box-shadow: 12px 0 28px rgba(17, 30, 67, .16);\n    }\n    .shell-sidebar.open {\n      transform: translateX(0);\n    }\n    .shell-main {\n      min-height: 100vh;\n    }\n    .main-inner {\n      padding: 24px 18px 24px;\n    }\n    .page-heading {\n      gap: 10px;\n    }\n    .heading-mark {\n      height: 48px;\n    }\n    .main-heading {\n      font-size: 25px;\n    }\n    .heading-description {\n      font-size: 13px;\n    }\n    .workbar {\n      display: block;\n      margin-top: 24px;\n      padding-bottom: 14px;\n    }\n    .search-container {\n      max-width: none;\n    }\n    .stat-badge {\n      min-height: auto;\n      margin-top: 13px;\n      padding: 0;\n      border-left: 0;\n      font-size: 12px;\n    }\n    .content-layout {\n      display: flex;\n      flex-direction: column;\n      gap: 28px;\n      margin-top: 24px;\n    }\n    .context-panel {\n      order: -1;\n      width: 100%;\n    }\n    .context-rule {\n      display: none;\n    }\n    .context-count {\n      margin-top: 13px !important;\n    }\n    .context-copy {\n      margin-top: 13px !important;\n    }\n    .section-head p {\n      display: none;\n    }\n    .card {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr) auto;\n      gap: 17px 10px;\n      padding: 18px 16px;\n    }\n    .identity-zone {\n      grid-column: 1 / -1;\n      padding-right: 0;\n    }\n    .data-zone {\n      min-height: 50px;\n      padding: 0 12px 0 0;\n      border-left: 0;\n    }\n    .update-zone {\n      border-left: 1px solid var(--line-soft);\n      padding-left: 14px;\n    }\n    .card-actions {\n      grid-column: 1 / -1;\n      display: grid;\n      grid-template-columns: 1fr auto;\n      gap: 10px;\n      padding: 15px 0 0;\n      margin-top: 0;\n    }\n    .btn-primary,\n    .btn-secondary {\n      min-width: 0;\n      width: 100%;\n    }\n    .app-footer {\n      align-items: flex-start;\n      flex-direction: column;\n      padding: 17px 18px 20px;\n    }\n  }\n</style>\n<div class=\"plussoft-page min-h-screen flex\" data-kid=\"1\">\n    <aside aria-label=\"Categorias de produtos\" class=\"shell-sidebar\" data-kid=\"1-1\" id=\"sidebar\">\n        <div class=\"brand-block\" data-kid=\"1-1-1\">\n            <img alt=\"PlusSoft\" data-kid=\"1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/logo-plussoft.png\"/>\n            <div class=\"brand-note\" data-kid=\"1-1-1-2\">\n                Software Center\n            </div>\n        </div>\n        <div aria-hidden=\"true\" class=\"brand-rule\" data-kid=\"1-1-2\">\n        </div>\n        <nav aria-label=\"Categorias de downloads\" class=\"menu\" data-kid=\"1-1-3\">\n            <button class=\"menu-item active\" data-id=\"1\" data-kid=\"1-1-3-1\" type=\"button\">\n                <span class=\"menu-text\" data-kid=\"1-1-3-1-1\">\n                    Ferramentas PlusSoft\n                </span>\n                <span aria-hidden=\"true\" class=\"menu-chevron\" data-kid=\"1-1-3-1-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"menu-item\" data-id=\"2\" data-kid=\"1-1-3-2\" type=\"button\">\n                <span class=\"menu-text\" data-kid=\"1-1-3-2-1\">\n                    Ferramentas SQL\n                </span>\n                <span aria-hidden=\"true\" class=\"menu-chevron\" data-kid=\"1-1-3-2-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"menu-item\" data-id=\"3\" data-kid=\"1-1-3-3\" type=\"button\">\n                <span class=\"menu-text\" data-kid=\"1-1-3-3-1\">\n                    IdealSoft\n                </span>\n                <span aria-hidden=\"true\" class=\"menu-chevron\" data-kid=\"1-1-3-3-2\">\n                    ›\n                </span>\n            </button>\n            <button class=\"menu-item\" data-id=\"4\" data-kid=\"1-1-3-4\" type=\"button\">\n                <span class=\"menu-text\" data-kid=\"1-1-3-4-1\">\n                    Links Úteis\n                </span>\n                <span aria-hidden=\"true\" class=\"menu-chevron\" data-kid=\"1-1-3-4-2\">\n                    ›\n                </span>\n            </button>\n        </nav>\n        <div class=\"sidebar-bottom\" data-kid=\"1-1-4\">\n            <a class=\"login-btn\" data-kid=\"1-1-4-1\" href=\"https://plussoft.com.br/login\">\n                <i aria-hidden=\"true\" class=\"ti ti-login-2\" data-kid=\"1-1-4-1-1\">\n                </i>\n                <span data-kid=\"1-1-4-1-2\">\n                    Fazer login\n                </span>\n            </a>\n        </div>\n    </aside>\n    <main class=\"shell-main\" data-kid=\"1-2\">\n        <div class=\"main-inner\" data-kid=\"1-2-1\">\n            <header class=\"page-heading\" data-kid=\"1-2-1-1\">\n                <div aria-hidden=\"true\" class=\"heading-mark\" data-kid=\"1-2-1-1-1\">\n                </div>\n                <div data-kid=\"1-2-1-1-2\">\n                    <h1 class=\"main-heading\" data-kid=\"1-2-1-1-2-1\">\n                        Programas e atualizações\n                    </h1>\n                    <p class=\"heading-description\" data-kid=\"1-2-1-1-2-2\">\n                        Downloads oficiais, ferramentas e versões atualizadas dos produtos PlusSoft.\n                    </p>\n                </div>\n            </header>\n            <div class=\"workbar\" data-kid=\"1-2-1-2\">\n                <div class=\"search-container\" data-kid=\"1-2-1-2-1\">\n                    <div class=\"search\" data-kid=\"1-2-1-2-1-1\">\n                        <i aria-hidden=\"true\" class=\"ti ti-search search-icon\" data-kid=\"1-2-1-2-1-1-1\">\n                        </i>\n                        <label class=\"sr-only\" data-kid=\"1-2-1-2-1-1-2\" for=\"searchInput\">\n                            Buscar programa, versão ou produto\n                        </label>\n                        <input data-kid=\"1-2-1-2-1-1-3\" id=\"searchInput\" placeholder=\"Buscar programa, versão ou produto\" type=\"search\"/>\n                        <span class=\"shortcut-badge\" data-kid=\"1-2-1-2-1-1-4\">\n                            Enter ↵\n                        </span>\n                    </div>\n                </div>\n                <span class=\"stat-badge outline\" data-kid=\"1-2-1-2-2\" id=\"summaryCountContainer\">\n                    <i aria-hidden=\"true\" class=\"ti ti-package\" data-kid=\"1-2-1-2-2-1\">\n                    </i>\n                    <span data-kid=\"1-2-1-2-2-2\">\n                        <strong data-kid=\"1-2-1-2-2-2-1\" data-name=\"available programs counter\" id=\"summaryCount\">\n                            2\n                        </strong>\n                        programas disponíveis\n                    </span>\n                </span>\n            </div>\n            <div class=\"content-layout\" data-kid=\"1-2-1-3\">\n                <section aria-labelledby=\"sectionTitle\" class=\"collection\" data-kid=\"1-2-1-3-1\">\n                    <div class=\"section-head\" data-kid=\"1-2-1-3-1-1\">\n                        <h2 data-kid=\"1-2-1-3-1-1-1\" id=\"sectionTitle\">\n                            Ferramentas PlusSoft\n                        </h2>\n                        <p data-kid=\"1-2-1-3-1-1-2\">\n                            Catálogo oficial\n                        </p>\n                    </div>\n                    <div class=\"grid\" data-kid=\"1-2-1-3-1-2\" data-name=\"application card grid container\" id=\"grid\">\n                        <article class=\"card\" data-kid=\"1-2-1-3-1-2-1\">\n                            <div class=\"identity-zone\" data-kid=\"1-2-1-3-1-2-1-1\">\n                                <div aria-hidden=\"true\" class=\"app-icon-img app-mark-f\" data-kid=\"1-2-1-3-1-2-1-1-1\">\n                                    F\n                                </div>\n                                <div class=\"app-info\" data-kid=\"1-2-1-3-1-2-1-1-2\">\n                                    <h3 class=\"app-title\" data-kid=\"1-2-1-3-1-2-1-1-2-1\">\n                                        FotoPlus\n                                    </h3>\n                                    <div class=\"app-category\" data-kid=\"1-2-1-3-1-2-1-1-2-2\">\n                                        Ferramentas PlusSoft\n                                    </div>\n                                    <p class=\"app-summary\" data-kid=\"1-2-1-3-1-2-1-1-2-3\">\n                                        Aplicativo integrado.\n                                    </p>\n                                </div>\n                                <span class=\"status\" data-kid=\"1-2-1-3-1-2-1-1-3\">\n                                    Atualizado\n                                </span>\n                            </div>\n                            <div class=\"data-zone meta\" data-kid=\"1-2-1-3-1-2-1-2\">\n                                <span class=\"meta-label\" data-kid=\"1-2-1-3-1-2-1-2-1\">\n                                    Versão atual\n                                </span>\n                                <strong class=\"meta-value\" data-kid=\"1-2-1-3-1-2-1-2-2\">\n                                    1.1.1\n                                </strong>\n                            </div>\n                            <div class=\"data-zone update-zone meta\" data-kid=\"1-2-1-3-1-2-1-3\">\n                                <span class=\"meta-label\" data-kid=\"1-2-1-3-1-2-1-3-1\">\n                                    Atualizado em\n                                </span>\n                                <strong class=\"meta-value\" data-kid=\"1-2-1-3-1-2-1-3-2\">\n                                    15/09/2026\n                                    <span class=\"time\" data-kid=\"1-2-1-3-1-2-1-3-2-1\">\n                                        • 14:35\n                                    </span>\n                                </strong>\n                            </div>\n                            <div class=\"card-actions\" data-kid=\"1-2-1-3-1-2-1-4\">\n                                <a class=\"btn btn-primary\" data-kid=\"1-2-1-3-1-2-1-4-1\" href=\"#download-fotoplus\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-download\" data-kid=\"1-2-1-3-1-2-1-4-1-1\">\n                                    </i>\n                                    <span data-kid=\"1-2-1-3-1-2-1-4-1-2\">\n                                        Download\n                                    </span>\n                                </a>\n                                <button class=\"btn btn-secondary\" data-kid=\"1-2-1-3-1-2-1-4-2\" type=\"button\">\n                                    <span data-kid=\"1-2-1-3-1-2-1-4-2-1\">\n                                        Detalhes\n                                    </span>\n                                    <i aria-hidden=\"true\" class=\"ti ti-chevron-right\" data-kid=\"1-2-1-3-1-2-1-4-2-2\">\n                                    </i>\n                                </button>\n                            </div>\n                        </article>\n                        <article class=\"card card--missing\" data-kid=\"1-2-1-3-1-2-2\">\n                            <div class=\"identity-zone\" data-kid=\"1-2-1-3-1-2-2-1\">\n                                <div aria-hidden=\"true\" class=\"app-icon-img app-mark-p\" data-kid=\"1-2-1-3-1-2-2-1-1\">\n                                    P\n                                </div>\n                                <div class=\"app-info\" data-kid=\"1-2-1-3-1-2-2-1-2\">\n                                    <h3 class=\"app-title\" data-kid=\"1-2-1-3-1-2-2-1-2-1\">\n                                        PlusColetor\n                                    </h3>\n                                    <div class=\"app-category\" data-kid=\"1-2-1-3-1-2-2-1-2-2\">\n                                        Ferramentas PlusSoft\n                                    </div>\n                                    <p class=\"app-summary\" data-kid=\"1-2-1-3-1-2-2-1-2-3\">\n                                        Aplicativo integrado.\n                                    </p>\n                                </div>\n                                <span class=\"status\" data-kid=\"1-2-1-3-1-2-2-1-3\">\n                                    Atualizado\n                                </span>\n                            </div>\n                            <div class=\"data-zone meta\" data-kid=\"1-2-1-3-1-2-2-2\">\n                                <span class=\"meta-label\" data-kid=\"1-2-1-3-1-2-2-2-1\">\n                                    Versão atual\n                                </span>\n                                <strong class=\"meta-value\" data-kid=\"1-2-1-3-1-2-2-2-2\">\n                                    N/A\n                                </strong>\n                            </div>\n                            <div class=\"data-zone update-zone meta\" data-kid=\"1-2-1-3-1-2-2-3\">\n                                <span class=\"meta-label\" data-kid=\"1-2-1-3-1-2-2-3-1\">\n                                    Atualizado em\n                                </span>\n                                <strong class=\"meta-value\" data-kid=\"1-2-1-3-1-2-2-3-2\">\n                                    Ainda não informado\n                                </strong>\n                            </div>\n                            <div class=\"card-actions\" data-kid=\"1-2-1-3-1-2-2-4\">\n                                <a class=\"btn btn-primary\" data-kid=\"1-2-1-3-1-2-2-4-1\" href=\"#download-pluscoletor\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-download\" data-kid=\"1-2-1-3-1-2-2-4-1-1\">\n                                    </i>\n                                    <span data-kid=\"1-2-1-3-1-2-2-4-1-2\">\n                                        Download\n                                    </span>\n                                </a>\n                                <button class=\"btn btn-secondary\" data-kid=\"1-2-1-3-1-2-2-4-2\" type=\"button\">\n                                    <span data-kid=\"1-2-1-3-1-2-2-4-2-1\">\n                                        Detalhes\n                                    </span>\n                                    <i aria-hidden=\"true\" class=\"ti ti-chevron-right\" data-kid=\"1-2-1-3-1-2-2-4-2-2\">\n                                    </i>\n                                </button>\n                            </div>\n                        </article>\n                    </div>\n                    <div class=\"empty\" data-kid=\"1-2-1-3-1-3\" data-name=\"no results empty state\" id=\"emptyState\">\n                        Nenhum programa encontrado nesta categoria.\n                    </div>\n                </section>\n                <aside aria-label=\"Contexto da categoria\" class=\"context-panel\" data-kid=\"1-2-1-3-2\">\n                    <div class=\"context-eyebrow\" data-kid=\"1-2-1-3-2-1\">\n                        Categoria selecionada\n                    </div>\n                    <h3 data-kid=\"1-2-1-3-2-2\">\n                        Ferramentas PlusSoft\n                    </h3>\n                    <div class=\"context-count\" data-kid=\"1-2-1-3-2-3\">\n                        <strong data-kid=\"1-2-1-3-2-3-1\" data-name=\"category program count\">\n                            2\n                        </strong>\n                        <br data-kid=\"1-2-1-3-2-3-2\"/>\n                        programas disponíveis\n                    </div>\n                    <p class=\"context-copy\" data-kid=\"1-2-1-3-2-4\">\n                        Versões atuais em destaque, detalhes e histórico acessíveis sob demanda.\n                    </p>\n                    <div aria-hidden=\"true\" class=\"context-rule\" data-kid=\"1-2-1-3-2-5\">\n                    </div>\n                </aside>\n            </div>\n        </div>\n        <footer class=\"app-footer\" data-kid=\"1-2-2\">\n            <p data-kid=\"1-2-2-1\">\n                PlusSoft © 2026. Todos os direitos reservados.\n            </p>\n            <p data-kid=\"1-2-2-2\">\n                Rua Antonio Marroquim, 529 Baixão Arapiraca / Alagoas\n            </p>\n        </footer>\n    </main>\n    <div aria-hidden=\"true\" class=\"modal-overlay\" data-kid=\"1-3\" data-name=\"modal overlay container\" id=\"detailsModal\">\n        <div aria-labelledby=\"modalTitle\" aria-modal=\"true\" class=\"modal-content\" data-kid=\"1-3-1\" data-name=\"modal content\" role=\"dialog\">\n            <button aria-label=\"Fechar detalhes\" data-kid=\"1-3-1-1\" data-name=\"close modal button\" id=\"closeModal\" type=\"button\">\n                ×\n            </button>\n            <div class=\"modal-header\" data-kid=\"1-3-1-2\">\n                <div class=\"modal-icon\" data-kid=\"1-3-1-2-1\" data-name=\"modal app icon\" id=\"modalIcon\">\n                    F\n                </div>\n                <div data-kid=\"1-3-1-2-2\">\n                    <h3 data-kid=\"1-3-1-2-2-1\" data-name=\"modal title text\" id=\"modalTitle\">\n                        FotoPlus\n                    </h3>\n                    <span data-kid=\"1-3-1-2-2-2\" data-name=\"modal category text\" id=\"modalCategory\">\n                        Ferramentas PlusSoft\n                    </span>\n                </div>\n            </div>\n            <div class=\"modal-body\" data-kid=\"1-3-1-3\">\n                <p data-kid=\"1-3-1-3-1\" id=\"modalDesc\">\n                    Histórico de versões\n                </p>\n                <div data-kid=\"1-3-1-3-2\" data-name=\"modal version history list\" id=\"modalVersions\">\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n",
