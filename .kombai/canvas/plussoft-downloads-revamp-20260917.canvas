    "var_df813cb853c9": {
      "type": "variant",
      "label": "PlusSoft — Índice operacional",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@500;600;700&family=Noto+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.3.0/tabler-icons.min.css');\n\n  :root {\n    --ps-ink: #15213a;\n    --ps-ink-soft: #4d5b70;\n    --ps-muted: #69778b;\n    --ps-faint: #96a2b3;\n    --ps-line: #d9e0ea;\n    --ps-line-strong: #c7d1df;\n    --ps-paper: #ffffff;\n    --ps-canvas: #f7f8fa;\n    --ps-blue: #1f4aa8;\n    --ps-blue-dark: #16397e;\n    --ps-blue-soft: #eaf0fc;\n    --ps-blue-wash: #f5f8fe;\n    --ps-warm: #f4f6f9;\n    --ps-alert: #b66a5f;\n  }\n\n  .ps-page,\n  .ps-page * { box-sizing: border-box; }\n\n  .ps-page {\n    min-height: 900px;\n    width: 100%;\n    background: var(--ps-canvas);\n    color: var(--ps-ink);\n    font-family: 'Noto Sans', ui-sans-serif, system-ui, sans-serif;\n    font-size: 14px;\n    line-height: 1.45;\n    overflow: hidden;\n  }\n\n  .ps-shell {\n    min-height: 900px;\n    display: flex;\n    background: var(--ps-canvas);\n  }\n\n  .sidebar {\n    width: 248px;\n    flex: 0 0 248px;\n    min-height: 900px;\n    display: flex;\n    flex-direction: column;\n    padding: 28px 24px 24px;\n    background: var(--ps-paper);\n    border-right: 1px solid var(--ps-line);\n  }\n\n  .brand {\n    padding: 2px 4px 24px;\n    border-bottom: 1px solid var(--ps-line);\n  }\n\n  .brand img {\n    display: block;\n    width: 156px;\n    max-width: 100%;\n    height: auto;\n    object-fit: contain;\n  }\n\n  .brand-mark-line {\n    width: 24px;\n    height: 2px;\n    margin-top: 20px;\n    background: var(--ps-blue);\n  }\n\n  .menu {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n    padding-top: 28px;\n  }\n\n  .menu-item {\n    position: relative;\n    display: flex;\n    align-items: center;\n    width: 100%;\n    min-height: 44px;\n    padding: 0 10px 0 13px;\n    border: 1px solid transparent;\n    border-radius: 4px;\n    color: var(--ps-ink-soft);\n    background: transparent;\n    font: 600 13px/1.2 'Noto Sans', ui-sans-serif, sans-serif;\n    text-align: left;\n    letter-spacing: -0.01em;\n  }\n\n  .menu-item::before {\n    content: '';\n    position: absolute;\n    top: 9px;\n    bottom: 9px;\n    left: -1px;\n    width: 2px;\n    background: transparent;\n  }\n\n  .menu-item.active {\n    color: var(--ps-blue);\n    background: var(--ps-blue-soft);\n    border-color: #dfe8f8;\n  }\n\n  .menu-item.active::before { background: var(--ps-blue); }\n  .menu-item:hover { background: #f5f7fb; color: var(--ps-ink); }\n  .menu-item:focus-visible,\n  .btn:focus-visible,\n  .login-btn:focus-visible,\n  #searchInput:focus-visible,\n  .modal-close:focus-visible {\n    outline: 2px solid var(--ps-blue);\n    outline-offset: 2px;\n  }\n\n  .menu-text { flex: 1; }\n  .menu-chevron {\n    color: #a4afbd;\n    font-size: 15px;\n    line-height: 1;\n    padding-left: 8px;\n  }\n  .menu-item.active .menu-chevron { color: var(--ps-blue); }\n\n  .sidebar-bottom {\n    margin-top: auto;\n    padding-top: 22px;\n    border-top: 1px solid var(--ps-line);\n  }\n\n  .login-btn {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 9px;\n    min-height: 44px;\n    width: 100%;\n    border: 1px solid var(--ps-blue);\n    border-radius: 4px;\n    background: var(--ps-blue);\n    color: #fff;\n    font: 600 13px/1 'Noto Sans', ui-sans-serif, sans-serif;\n    text-decoration: none;\n  }\n\n  .login-btn:hover { background: var(--ps-blue-dark); }\n  .login-btn .ti { font-size: 17px; }\n\n  .main {\n    min-width: 0;\n    flex: 1;\n    min-height: 900px;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .content {\n    width: min(100%, 1080px);\n    margin: 0 auto;\n    padding: 48px 56px 36px;\n  }\n\n  .page-heading {\n    position: relative;\n    display: flex;\n    align-items: flex-start;\n    gap: 15px;\n    margin-bottom: 28px;\n    padding-left: 15px;\n  }\n\n  .page-heading::before {\n    content: '';\n    position: absolute;\n    left: 0;\n    top: 3px;\n    width: 3px;\n    height: 54px;\n    background: var(--ps-blue);\n  }\n\n  .mobile-menu {\n    display: none;\n    width: 44px;\n    height: 44px;\n    border: 1px solid var(--ps-line-strong);\n    border-radius: 4px;\n    background: #fff;\n    color: var(--ps-ink);\n    place-items: center;\n  }\n\n  .main-heading {\n    margin: 0;\n    color: var(--ps-ink);\n    font: 700 32px/1.12 'IBM Plex Sans', ui-sans-serif, sans-serif;\n    letter-spacing: -0.035em;\n  }\n\n  .page-description {\n    max-width: 620px;\n    margin: 9px 0 0;\n    color: var(--ps-muted);\n    font-size: 15px;\n    line-height: 1.55;\n  }\n\n  .search-and-stats {\n    display: flex;\n    align-items: center;\n    gap: 24px;\n    min-height: 72px;\n    margin: 0 0 42px;\n    padding: 11px 0;\n    border-top: 1px solid var(--ps-line);\n    border-bottom: 1px solid var(--ps-line);\n  }\n\n  .search-container { flex: 1; min-width: 0; }\n\n  .search {\n    display: flex;\n    align-items: center;\n    min-height: 48px;\n    width: 100%;\n    padding: 0 13px;\n    border: 1px solid var(--ps-line-strong);\n    border-radius: 4px;\n    background: var(--ps-paper);\n  }\n\n  .search:focus-within {\n    border-color: var(--ps-blue);\n    box-shadow: inset 0 0 0 1px var(--ps-blue);\n  }\n\n  .search-icon {\n    flex: 0 0 auto;\n    margin-right: 10px;\n    color: var(--ps-muted);\n    font-size: 19px;\n  }\n\n  .search input {\n    min-width: 0;\n    flex: 1;\n    height: 44px;\n    border: 0;\n    outline: none;\n    background: transparent;\n    color: var(--ps-ink);\n    font: 14px/1 'Noto Sans', ui-sans-serif, sans-serif;\n  }\n\n  .search input::placeholder { color: #8b98aa; }\n\n  .shortcut-badge {\n    flex: 0 0 auto;\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n    min-height: 25px;\n    padding: 0 7px;\n    border: 1px solid var(--ps-line);\n    border-radius: 3px;\n    background: #f1f4f8;\n    color: var(--ps-muted);\n    font: 500 11px/1 'IBM Plex Mono', monospace;\n  }\n\n  .stat-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 9px;\n    flex: 0 0 auto;\n    min-height: 48px;\n    padding: 0 2px 0 24px;\n    border-left: 1px solid var(--ps-line);\n    color: var(--ps-ink-soft);\n    font-size: 13px;\n    white-space: nowrap;\n  }\n\n  .stat-badge .ti { color: var(--ps-blue); font-size: 17px; }\n  .stat-badge strong { color: var(--ps-ink); font-weight: 700; }\n\n  .section-head {\n    display: flex;\n    align-items: end;\n    justify-content: space-between;\n    gap: 20px;\n    margin: 0;\n    padding-bottom: 16px;\n    border-bottom: 1px solid var(--ps-line-strong);\n  }\n\n  .section-head h2 {\n    margin: 0;\n    color: var(--ps-ink);\n    font: 600 19px/1.2 'IBM Plex Sans', ui-sans-serif, sans-serif;\n    letter-spacing: -0.015em;\n  }\n\n  .section-head p {\n    margin: 3px 0 0;\n    color: var(--ps-muted);\n    font-size: 12px;\n  }\n\n  .list-columns,\n  .card {\n    display: grid;\n    grid-template-columns: minmax(270px, 1.7fr) minmax(115px, .68fr) minmax(165px, .9fr) minmax(170px, .92fr);\n    column-gap: 20px;\n    align-items: center;\n  }\n\n  .list-columns {\n    min-height: 41px;\n    padding: 0 18px;\n    border-bottom: 1px solid var(--ps-line);\n    color: var(--ps-muted);\n    font: 600 10px/1 'Noto Sans', ui-sans-serif, sans-serif;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .grid {\n    display: block;\n    background: var(--ps-paper);\n    border-bottom: 1px solid var(--ps-line);\n  }\n\n  .card {\n    min-height: 126px;\n    padding: 19px 18px;\n    border-bottom: 1px solid var(--ps-line);\n    background: var(--ps-paper);\n  }\n\n  .card:last-child { border-bottom: 0; }\n  .card:hover { background: var(--ps-blue-wash); }\n\n  .card-header {\n    min-width: 0;\n    display: flex;\n    align-items: center;\n    gap: 13px;\n  }\n\n  .app-icon-img,\n  .app-mark {\n    width: 44px;\n    height: 44px;\n    flex: 0 0 44px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--ps-line-strong);\n    border-radius: 4px;\n    background: #f8fafc;\n    object-fit: contain;\n    padding: 5px;\n  }\n\n  .app-mark {\n    padding: 0;\n    color: var(--ps-blue);\n    font: 700 18px/1 'IBM Plex Sans', sans-serif;\n  }\n\n  .app-mark.orange {\n    color: #b75d4b;\n    background: #fff8f5;\n  }\n\n  .app-info { min-width: 0; }\n\n  .app-title {\n    overflow: hidden;\n    margin: 0;\n    color: var(--ps-ink);\n    font: 600 15px/1.25 'IBM Plex Sans', ui-sans-serif, sans-serif;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .app-category {\n    margin-top: 5px;\n    overflow: hidden;\n    color: var(--ps-muted);\n    font-size: 11px;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .card p {\n    grid-column: 1 / 2;\n    margin: 8px 0 0 57px;\n    overflow: hidden;\n    color: var(--ps-muted);\n    font-size: 12px;\n    line-height: 1.45;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n  }\n\n  .card-header + p { align-self: start; }\n\n  .meta {\n    display: contents;\n  }\n\n  .meta > div {\n    min-width: 0;\n    padding-left: 18px;\n    border-left: 1px solid var(--ps-line);\n  }\n\n  .meta-label {\n    color: var(--ps-muted);\n    font: 600 10px/1.2 'Noto Sans', sans-serif;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n  }\n\n  .meta-value {\n    margin-top: 7px;\n    overflow: hidden;\n    color: var(--ps-ink);\n    font: 600 13px/1.25 'IBM Plex Mono', monospace;\n    font-variant-numeric: tabular-nums;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n\n  .meta > div:nth-child(2) .meta-value { color: var(--ps-ink-soft); font-size: 12px; }\n  .meta-value.muted { color: var(--ps-faint); font-weight: 500; }\n\n  .status { display: none; }\n\n  .card-actions {\n    display: flex;\n    align-items: center;\n    justify-content: flex-start;\n    gap: 10px;\n    min-width: 0;\n  }\n\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n    min-height: 38px;\n    border-radius: 4px;\n    padding: 0 12px;\n    font: 600 12px/1 'Noto Sans', ui-sans-serif, sans-serif;\n    white-space: nowrap;\n    text-decoration: none;\n  }\n\n  .btn .ti { font-size: 15px; }\n\n  .btn-primary {\n    border: 1px solid var(--ps-blue);\n    background: var(--ps-blue);\n    color: #fff;\n  }\n\n  .btn-primary:hover { border-color: var(--ps-blue-dark); background: var(--ps-blue-dark); }\n\n  .btn-secondary {\n    border: 1px solid transparent;\n    background: transparent;\n    color: var(--ps-blue);\n  }\n\n  .btn-secondary:hover { border-color: var(--ps-line-strong); background: #fff; }\n\n  .empty {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n    min-height: 72px;\n    margin-top: 20px;\n    padding: 12px 16px;\n    border: 1px solid var(--ps-line);\n    border-left: 3px solid #aebbd0;\n    background: #fbfcfd;\n    color: var(--ps-ink-soft);\n  }\n\n  .empty .ti { color: var(--ps-muted); font-size: 20px; }\n  .empty-copy { min-width: 0; flex: 1; }\n  .empty strong { display: block; color: var(--ps-ink); font: 600 12px/1.2 'IBM Plex Sans', sans-serif; }\n  .empty span { display: block; margin-top: 3px; color: var(--ps-muted); font-size: 11px; }\n  .empty-note {\n    color: var(--ps-faint);\n    font: 500 10px/1 'IBM Plex Mono', monospace;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .secondary-specimens {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 410px;\n    gap: 20px;\n    align-items: start;\n    margin-top: 20px;\n  }\n\n  .specimen-label {\n    margin: 0 0 8px;\n    color: var(--ps-faint);\n    font: 600 10px/1 'IBM Plex Mono', monospace;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .modal-overlay.static-specimen {\n    position: relative;\n    inset: auto;\n    display: block;\n    min-height: 0;\n    padding: 0;\n    background: transparent;\n    opacity: 1;\n    pointer-events: auto;\n  }\n\n  .modal-content {\n    position: relative;\n    width: 100%;\n    padding: 22px;\n    border: 1px solid var(--ps-line-strong);\n    border-radius: 8px;\n    background: #fff;\n    box-shadow: 0 12px 28px rgba(21, 33, 58, .10);\n  }\n\n  .modal-close {\n    position: absolute;\n    top: 14px;\n    right: 14px;\n    display: grid;\n    place-items: center;\n    width: 34px;\n    height: 34px;\n    border: 1px solid transparent;\n    border-radius: 4px;\n    background: transparent;\n    color: var(--ps-muted);\n  }\n\n  .modal-close:hover { border-color: var(--ps-line); background: #f7f8fa; color: var(--ps-ink); }\n  .modal-close .ti { font-size: 18px; }\n\n  .modal-header {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding-right: 38px;\n    padding-bottom: 17px;\n    border-bottom: 1px solid var(--ps-line);\n  }\n\n  .modal-icon {\n    width: 42px;\n    height: 42px;\n    display: grid;\n    place-items: center;\n    border: 1px solid var(--ps-line-strong);\n    border-radius: 4px;\n    background: #f8fafc;\n    color: var(--ps-blue);\n    font: 700 17px/1 'IBM Plex Sans', sans-serif;\n  }\n\n  .modal-title {\n    margin: 0;\n    color: var(--ps-ink);\n    font: 600 17px/1.2 'IBM Plex Sans', sans-serif;\n  }\n\n  .modal-category {\n    display: block;\n    margin-top: 4px;\n    color: var(--ps-blue);\n    font-size: 11px;\n  }\n\n  .modal-body {\n    padding-top: 17px;\n  }\n\n  .modal-desc {\n    margin: 0 0 10px;\n    color: var(--ps-ink);\n    font: 600 12px/1.2 'IBM Plex Sans', sans-serif;\n  }\n\n  #modalVersions {\n    max-height: 124px;\n    overflow: auto;\n    border-top: 1px solid var(--ps-line);\n  }\n\n  #modalVersions ul {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n  }\n\n  #modalVersions li {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 14px;\n    min-height: 42px;\n    padding: 0;\n    border-bottom: 1px solid var(--ps-line) !important;\n  }\n\n  #modalVersions li strong {\n    color: var(--ps-ink);\n    font: 600 12px/1 'IBM Plex Mono', monospace;\n  }\n\n  #modalVersions li span {\n    margin-left: 9px !important;\n    color: var(--ps-muted) !important;\n    font: 11px/1 'IBM Plex Mono', monospace !important;\n  }\n\n  #modalVersions li a {\n    display: inline-flex;\n    align-items: center;\n    min-height: 28px;\n    border: 1px solid var(--ps-blue);\n    border-radius: 3px;\n    padding: 0 9px !important;\n    background: #fff !important;\n    color: var(--ps-blue) !important;\n    font: 600 10px/1 'Noto Sans', sans-serif !important;\n    text-decoration: none;\n  }\n\n  .app-footer {\n    margin-top: auto;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    min-height: 54px;\n    padding: 0 56px;\n    border-top: 1px solid var(--ps-line);\n    background: #f1f4f8;\n    color: var(--ps-muted);\n    font-size: 11px;\n  }\n\n  .app-footer p { margin: 0; }\n\n  @media (max-width: 900px) {\n    .content { padding-inline: 32px; }\n    .list-columns,\n    .card { grid-template-columns: minmax(235px, 1.5fr) minmax(105px, .7fr) minmax(145px, .8fr) auto; column-gap: 12px; }\n    .btn-secondary { padding-inline: 6px; }\n    .secondary-specimens { grid-template-columns: 1fr; }\n  }\n\n  @media (max-width: 760px) {\n    .ps-page, .ps-shell, .main { min-height: 100vh; }\n    .ps-page { overflow: visible; }\n    .ps-shell { display: block; }\n    .sidebar { position: fixed; z-index: 40; inset: 0 auto 0 0; width: min(280px, 86vw); min-height: 100vh; transform: translateX(-100%); box-shadow: 0 12px 28px rgba(21,33,58,.16); }\n    .sidebar.open { transform: translateX(0); }\n    .main { margin-left: 0; }\n    .content { width: 100%; padding: 22px 18px 28px; }\n    .page-heading { 